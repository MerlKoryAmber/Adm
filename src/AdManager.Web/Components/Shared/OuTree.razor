@inject IOuTreeProvider OuTreeProvider

@* OU-дерево со сворачиванием (как в AD-консоли). Полное дерево берётся из кэша
   (IOuTreeProvider, обновляется по расписанию). Режимы:
   Selectable=true — каскадные чекбоксы (отметил родителя → все потомки; снял ребёнка →
   исключился; родитель показывает indeterminate при частичном выборе).
   Иначе — клик по строке = навигация (SelectedDn / OnSelect). *@

<div class="outree @(FullHeight ? "outree-full" : null)">
    @if (nodes is null)
    {
        <p class="muted" style="padding:8px">Loading…</p>
    }
    else if (nodes.Count == 0)
    {
        <p class="muted" style="padding:8px">No OUs.</p>
    }
    else
    {
        @foreach (var n in Roots())
        {
            @RenderNode(n)
        }
    }
</div>

@code {
    [Parameter] public bool Selectable { get; set; }
    [Parameter] public HashSet<string>? Selected { get; set; }
    [Parameter] public string? SelectedDn { get; set; }
    [Parameter] public EventCallback<AdOuNode> OnSelect { get; set; }
    [Parameter] public EventCallback OnSelectionChanged { get; set; }
    [Parameter] public bool FullHeight { get; set; } = true;

    private sealed class TreeNode
    {
        public required AdOuNode Ou { get; init; }
        public TreeNode? Parent { get; set; }
        public List<TreeNode> Children { get; } = new();
        public bool Expanded { get; set; }
    }

    private IReadOnlyList<AdOuNode>? nodes;
    private List<TreeNode> allNodes = new();
    private Dictionary<string, TreeNode> byDn = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        nodes = await OuTreeProvider.GetTreeAsync();
        BuildTree();
    }

    /// <summary>Собрать дерево из плоского иерархически-упорядоченного списка по DN родителя.</summary>
    private void BuildTree()
    {
        allNodes = new();
        byDn = new(StringComparer.OrdinalIgnoreCase);
        if (nodes is null) return;
        foreach (var ou in nodes)
        {
            var tn = new TreeNode { Ou = ou };
            allNodes.Add(tn);
            byDn[ou.Dn] = tn;
        }
        foreach (var tn in allNodes)
        {
            var parentDn = ParentDn(tn.Ou.Dn);
            if (parentDn != null && byDn.TryGetValue(parentDn, out var p))
            {
                tn.Parent = p;
                p.Children.Add(tn);
            }
        }
    }

    private IEnumerable<TreeNode> Roots() => allNodes.Where(n => n.Parent is null);

    private static string? ParentDn(string dn)
    {
        var i = dn.IndexOf(',');
        return i >= 0 ? dn[(i + 1)..] : null;
    }

    private async Task Toggle(TreeNode n) { n.Expanded = !n.Expanded; await Task.CompletedTask; }

    private async Task RowClick(TreeNode n)
    {
        if (Selectable) { await SetChecked(n, !IsChecked(n)); }
        else { await OnSelect.InvokeAsync(n.Ou); }
    }

    private bool IsChecked(TreeNode n) => Selected != null && Selected.Contains(n.Ou.Dn);

    /// <summary>Частично выбран: среди узла+потомков есть и выбранные, и невыбранные.
    /// Показывает "не всё поддерево в scope" даже когда сам узел отмечен.</summary>
    private bool IsIndeterminate(TreeNode n)
    {
        var all = DescendantsAndSelf(n).ToList();
        var checkedCount = all.Count(IsChecked);
        return checkedCount > 0 && checkedCount < all.Count;
    }

    private IEnumerable<TreeNode> DescendantsAndSelf(TreeNode n)
    {
        yield return n;
        foreach (var c in n.Children)
            foreach (var d in DescendantsAndSelf(c))
                yield return d;
    }

    /// <summary>Каскад: отметить/снять узел вместе со всеми потомками.</summary>
    private async Task SetChecked(TreeNode n, bool on)
    {
        if (Selected is null) return;
        foreach (var d in DescendantsAndSelf(n))
        {
            if (on) Selected.Add(d.Ou.Dn);
            else Selected.Remove(d.Ou.Dn);
        }
        await OnSelectionChanged.InvokeAsync();
        StateHasChanged();
    }

    private RenderFragment RenderNode(TreeNode n) => __builder =>
    {
        var depth = n.Ou.Depth;
        var isSel = Selectable && IsChecked(n);
        var isCur = !Selectable && SelectedDn == n.Ou.Dn;
        var indeterminate = Selectable && IsIndeterminate(n);
        <div class="outree-row @(isSel ? "checked" : null) @(isCur ? "selected" : null)"
             style="padding-left:@(6 + depth * 18)px">
            @if (n.Children.Count > 0)
            {
                <span class="outree-caret @(n.Expanded ? "open" : null)" @onclick="() => Toggle(n)" @onclick:stopPropagation="true">▶</span>
            }
            else
            {
                <span class="outree-caret empty"></span>
            }
            @if (Selectable)
            {
                <input type="checkbox" checked="@isSel"
                       @onchange="e => SetChecked(n, (bool)(e.Value ?? false))"
                       @onclick:stopPropagation="true"
                       class="@(indeterminate ? "indeterminate" : null)" />
            }
            <span class="ouicon" @onclick="() => RowClick(n)">🗀</span>
            <span class="outree-name" @onclick="() => RowClick(n)">@n.Ou.Name</span>
        </div>
        @if (n.Expanded)
        {
            @foreach (var c in n.Children)
            {
                @RenderNode(c)
            }
        }
    };
}
