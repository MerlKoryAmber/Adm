@inherits LayoutComponentBase
@inject UiOptions Ui
@inject NavigationManager Nav
@inject IRbacEngine Rbac
@implements IDisposable
@using AdManager.Domain.Enums

<div class="shell">
    <header class="topbar">
        <div class="logo">ADManager<span>·lab</span></div>
        <nav class="tabs">
            <a class="tab @(Section == "Dashboard" ? "active" : null)" href="dashboard">Dashboard</a>
            @if (CanManagement) { <a class="tab @(Section == "Management" ? "active" : null)" href="@ManagementHome">Management</a> }
            @if (access.Can(Permission.ViewReports)) { <a class="tab @(Section == "Reports" ? "active" : null)" href="reports">Reports</a> }
            @if (access.Can(Permission.ManageDelegation)) { <a class="tab @(Section == "Delegation" ? "active" : null)" href="delegation">Delegation</a> }
            @if (access.Can(Permission.ManageAutomation)) { <a class="tab @(Section == "Automation" ? "active" : null)" href="automation">Automation</a> }
            @if (access.Can(Permission.ManagePasswordExpiry)) { <a class="tab @(Section == "PasswordExpiry" ? "active" : null)" href="password-expiry">Password Expiry</a> }
            @if (access.Can(Permission.ManageSettings)) { <a class="tab @(Section == "Settings" ? "active" : null)" href="settings">Settings</a> }
            @if (access.Can(Permission.ManageDelegation)) { <a class="tab @(Section == "Administration" ? "active" : null)" href="administration">Administration</a> }
        </nav>
        <div class="topright">
            <span class="domainchip">Domain: @Ui.Domain</span>
            <AuthorizeView>
                <Authorized>
                    <span class="who">@context.User.Identity?.Name</span>
                    <form method="post" action="/logout" style="display:inline;margin:0"><button type="submit" class="linkbtn">Sign out</button></form>
                </Authorized>
                <NotAuthorized><span class="who">not signed in</span></NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <div class="body">
        @if (Section != "Dashboard")
        {
        <aside class="tree">
            @if (Section == "Management")
            {
                @if (CanUsers)
                {
                    <NavLink class="treeitem" href="search">🔍 Advanced search</NavLink>
                    <div class="treegroup">User Management</div>
                    <NavLink class="treeitem" href="users" Match="NavLinkMatch.All">Modify users</NavLink>
                    @if (access.Can(Permission.CreateUser)) { <NavLink class="treeitem" href="users/create">Create user</NavLink> }
                    @if (access.Can(Permission.CreateUser)) { <NavLink class="treeitem" href="users/bulk">Bulk create (CSV)</NavLink> }
                    <NavLink class="treeitem" href="templates">Form templates</NavLink>
                }
                @if (CanGroups)
                {
                    <div class="treegroup">Group Management</div>
                    <NavLink class="treeitem" href="groups" Match="NavLinkMatch.All">Modify groups</NavLink>
                    @if (access.Can(Permission.CreateGroup)) { <NavLink class="treeitem" href="groups/create">Create group</NavLink> }
                }
                @if (CanComputers)
                {
                    <div class="treegroup">Computer Management</div>
                    <NavLink class="treeitem" href="computers" Match="NavLinkMatch.All">Modify computers</NavLink>
                    @if (access.Can(Permission.CreateComputer)) { <NavLink class="treeitem" href="computers/create">Create computer</NavLink> }
                }
                @if (CanOus)
                {
                    <div class="treegroup">OU Management</div>
                    <NavLink class="treeitem" href="ous" Match="NavLinkMatch.All">Modify OUs</NavLink>
                    @if (access.Can(Permission.CreateOu)) { <NavLink class="treeitem" href="ous/create">Create OU</NavLink> }
                }
                @if (access.Can(Permission.ManageGpoLinks))
                {
                    <div class="treegroup">Group Policy</div>
                    <NavLink class="treeitem" href="gpo">Group Policy Objects</NavLink>
                }
                @if (CanContacts)
                {
                    <div class="treegroup">Contact Management</div>
                    <NavLink class="treeitem" href="contacts" Match="NavLinkMatch.All">Modify contacts</NavLink>
                    @if (access.Can(Permission.CreateContact)) { <NavLink class="treeitem" href="contacts/create">Create contact</NavLink> }
                }
                @if (CanExchange)
                {
                    <div class="treegroup">Exchange</div>
                    <NavLink class="treeitem" href="exchange">Mailboxes &amp; Groups</NavLink>
                }
            }
            else if (Section == "Reports")
            {
                <div class="treegroup">Reports</div>
                <a class="treeitem" href="reports?r=all">All users</a>
                <a class="treeitem" href="reports?r=disabled">Disabled users</a>
                <a class="treeitem" href="reports?r=locked">Locked-out users</a>
                <a class="treeitem" href="reports?r=noemail">Users without email</a>
                <a class="treeitem" href="reports?r=nomanager">Users without manager</a>
                <a class="treeitem" href="reports?r=pne">Password never expires</a>
                <div class="treegroup">Logs</div>
                <NavLink class="treeitem" href="audit">Audit log</NavLink>
            }
            else if (Section == "Delegation")
            {
                <div class="treegroup">Help Desk Delegation</div>
                <a class="treeitem" href="delegation?s=roles">Roles</a>
                <a class="treeitem" href="delegation?s=scopes">Scopes</a>
                <a class="treeitem" href="delegation?s=assignments">Assignments</a>
                <div class="treegroup">Help Desk Audit Reports</div>
                <a class="treeitem" href="delegation?s=audit-report">Audit Report</a>
                <a class="treeitem" href="delegation?s=admin-audit">Admin Audit Report</a>
                <div class="treegroup">Help Desk Reports</div>
                <a class="treeitem" href="delegation?s=technicians-report">Technicians Report</a>
                <a class="treeitem" href="delegation?s=logon-report">Technician Logon Report</a>
            }
            else if (Section == "Automation")
            {
                <div class="treegroup">Automation</div>
                <NavLink class="treeitem" href="automation" Match="NavLinkMatch.All">Policies</NavLink>
            }
            else if (Section == "PasswordExpiry")
            {
                <div class="treegroup">Password Expiry</div>
                <NavLink class="treeitem" href="password-expiry" Match="NavLinkMatch.All">Policy &amp; reminders</NavLink>
            }
            else if (Section == "Settings")
            {
                <div class="treegroup">Settings</div>
                <NavLink class="treeitem" href="settings" Match="NavLinkMatch.All">Email &amp; HTTPS</NavLink>
            }
            else if (Section == "Administration")
            {
                <div class="treegroup">Administration</div>
                <NavLink class="treeitem" href="administration" Match="NavLinkMatch.All">Panel users</NavLink>
            }
        </aside>
        }

        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    private string Section
    {
        get
        {
            var p = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
            if (p == "" || p.StartsWith("dashboard")) return "Dashboard";
            if (p.StartsWith("reports")) return "Reports";
            if (p.StartsWith("delegation")) return "Delegation";
            if (p.StartsWith("automation")) return "Automation";
            if (p.StartsWith("password-expiry")) return "PasswordExpiry";
            if (p.StartsWith("settings")) return "Settings";
            if (p.StartsWith("administration")) return "Administration";
            return "Management";
        }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private EffectiveAccess access = new(false, new HashSet<Permission>());

    // Групповые предикаты доступа к разделам Management.
    private bool CanUsers => access.CanAny(Permission.ResetPassword, Permission.UnlockAccount, Permission.EnableDisableUser,
        Permission.CreateUser, Permission.DeleteUser, Permission.ModifyAttributes, Permission.MoveObject,
        Permission.ManageGroupMembership, Permission.Rename, Permission.SetAccountOptions);
    private bool CanGroups => access.Can(Permission.CreateGroup);
    private bool CanComputers => access.CanAny(Permission.CreateComputer, Permission.ManageComputer);
    private bool CanOus => access.CanAny(Permission.CreateOu, Permission.ManageOu);
    private bool CanContacts => access.CanAny(Permission.CreateContact, Permission.ManageContact);
    private bool CanExchange => access.CanAny(Permission.EnableMailbox, Permission.DisableMailbox,
        Permission.SetMailboxProperties, Permission.ManageDistribution, Permission.ManageMailboxPermissions);
    private bool CanManagement => CanUsers || CanGroups || CanComputers || CanOus || CanContacts || CanExchange
        || access.Can(Permission.ManageGpoLinks);

    // Куда ведёт вкладка Management — первая доступная страница.
    private string ManagementHome =>
        CanUsers ? "users" : CanGroups ? "groups" : CanComputers ? "computers" :
        CanOus ? "ous" : CanContacts ? "contacts" : access.Can(Permission.ManageGpoLinks) ? "gpo" :
        CanExchange ? "exchange" : "users";

    private string? accessLoadedFor;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    // Грузим доступ после первого интерактивного рендера: при InteractiveServer AuthState
    // на пререндере ещё не аутентифицирован. Guard по имени — от повторной загрузки.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var user = AuthState is null ? null : (await AuthState).User;
        var name = user?.Identity?.Name ?? "";
        if (name == accessLoadedFor) return;
        accessLoadedFor = name;
        access = await Rbac.EffectiveAccessAsync(CurrentUser.From(user));
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
