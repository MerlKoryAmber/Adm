@page "/users/create"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject UiOptions Ui
@inject NavigationManager Nav

<PageTitle>Create user — admanager</PageTitle>
<h1>Create user</h1>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="toolbar" style="max-width:640px">
    <label style="margin:0">Target OU</label>
    <select @bind="ouDn" class="grow">
        <option value="@Ui.BaseDn">(domain root)</option>
        @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
        {
            <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
        }
    </select>
</div>

<div class="tabbar">
    @foreach (var t in Tabs)
    {
        <button class="tabbtn @(tab == t ? "on" : null)" @onclick="() => tab = t">@t</button>
    }
</div>

<div class="panel" style="max-width:640px">
    @if (tab == "General")
    {
        @Field("First name", "givenName")
        @Field("Initials", "initials")
        @Field("Last name", "sn")
        @Field("Display name", "displayName")
        <div class="hint">CN объекта. Если пусто — берётся sAMAccountName.</div>
        @Field("Description", "description")
        @Field("Office", "physicalDeliveryOfficeName")
        @Field("Telephone", "telephoneNumber")
        @Field("Email", "mail")
        @Field("Web page", "wWWHomePage")
    }
    else if (tab == "Account")
    {
        <label>SAM account name *</label>
        <input type="text" @bind="sam" placeholder="j.doe" />
        <label>User principal name</label>
        <input type="text" @bind="upnField" placeholder="@Upn" />
        <div class="hint">Если пусто — <code>@Upn</code>.</div>
        <label>Initial password</label>
        <input type="password" @bind="password" />
        <div class="hint">Нужен для включённой учётки; по политике домена.</div>
        <div class="checkbox"><input type="checkbox" id="en" @bind="enabled" /><label for="en">Enabled</label></div>
        <div class="checkbox"><input type="checkbox" id="mc" @bind="mustChange" /><label for="mc">Must change password at next logon</label></div>
    }
    else if (tab == "Address")
    {
        @Field("Street", "streetAddress")
        @Field("P.O. Box", "postOfficeBox")
        @Field("City", "l")
        @Field("State/Province", "st")
        @Field("Zip/Postal code", "postalCode")
        @Field("Country/Region", "co")
        @Field("Country code (ISO2)", "c")
    }
    else if (tab == "Telephones")
    {
        @Field("Home", "homePhone")
        @Field("Pager", "pager")
        @Field("Mobile", "mobile")
        @Field("Fax", "facsimileTelephoneNumber")
        @Field("IP phone", "ipPhone")
        @Field("Notes", "info")
    }
    else if (tab == "Organization")
    {
        @Field("Title", "title")
        @Field("Department", "department")
        @Field("Company", "company")
        @Field("Manager (DN)", "manager")
    }
    else if (tab == "Profile")
    {
        @Field("Profile path", "profilePath")
        @Field("Logon script", "scriptPath")
        @Field("Home folder (path)", "homeDirectory")
        @Field("Home drive", "homeDrive")
    }

    <div class="btnrow" style="margin-top:16px">
        <button class="primary" @onclick="Create" disabled="@string.IsNullOrWhiteSpace(sam)">Create user</button>
        <button @onclick='() => Nav.NavigateTo("users")'>Back to users</button>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly string[] Tabs = { "General", "Account", "Address", "Telephones", "Organization", "Profile" };
    private static readonly string[] AttrKeys =
    {
        "givenName","sn","initials","displayName","description","physicalDeliveryOfficeName","telephoneNumber","mail","wWWHomePage",
        "userPrincipalName","streetAddress","postOfficeBox","l","st","postalCode","co","c",
        "homePhone","pager","mobile","facsimileTelephoneNumber","ipPhone","info",
        "title","department","company","manager","profilePath","scriptPath","homeDirectory","homeDrive",
    };

    private List<AdOuNode>? ous;
    private readonly Dictionary<string, string?> model = new(StringComparer.OrdinalIgnoreCase);
    private string tab = "General";
    private string ouDn = "", sam = "", password = "", upnField = "";
    private bool enabled = true, mustChange;
    private string? banner; private bool ok;

    private string Upn => (string.IsNullOrWhiteSpace(sam) ? "user" : sam) + "@" + Ui.Domain;

    protected override async Task OnInitializedAsync()
    {
        ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList();
        ouDn = ous.Any(o => o.Dn == Ui.UsersOu) ? Ui.UsersOu : (ous.Any(o => o.Dn == Ui.RootOu) ? Ui.RootOu : Ui.BaseDn);
    }

    private RenderFragment Field(string label, string key) => builder =>
    {
        builder.OpenElement(0, "label"); builder.AddContent(1, label); builder.CloseElement();
        builder.OpenElement(2, "input");
        builder.AddAttribute(3, "type", "text");
        builder.AddAttribute(4, "value", model.GetValueOrDefault(key));
        builder.AddAttribute(5, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => model[key] = e.Value?.ToString()));
        builder.CloseElement();
    };

    private async Task Create()
    {
        var actor = CurrentUser.From(AuthState is null ? null : (await AuthState).User);
        var display = model.GetValueOrDefault("displayName");
        if (string.IsNullOrWhiteSpace(display)) display = sam;
        var upn = string.IsNullOrWhiteSpace(upnField) ? Upn : upnField.Trim();

        var attrs = new Dictionary<string, string?>();
        foreach (var k in AttrKeys)
        {
            if (k is "displayName" or "userPrincipalName") continue; // идут явными параметрами
            var v = model.GetValueOrDefault(k);
            if (!string.IsNullOrEmpty(v)) attrs[k] = v;
        }

        var req = new CreateUserRequest(ouDn, sam.Trim(), display!.Trim(), upn!.Trim(),
            InitialPassword: string.IsNullOrEmpty(password) ? null : password, Enabled: enabled, Attributes: attrs);

        var r = await Mgmt.CreateUserAsync(actor, req);
        ok = r.Success;
        banner = r.Success ? $"User '{sam}' created." : ("Error: " + r.Message);

        if (r.Success && mustChange)
        {
            var dn = $"CN={display.Trim()},{ouDn}";
            await Mgmt.SetAccountOptionsAsync(actor, dn, new AccountOptions(MustChangePasswordAtNextLogon: true));
        }
        if (r.Success) { sam = password = ""; model.Clear(); }
    }

    private static string Indent(int d) => new string(' ', d * 3);
}
