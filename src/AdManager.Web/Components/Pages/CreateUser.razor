@page "/users/create"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject IUserTemplateStore Templates
@inject UiOptions Ui
@inject NavigationManager Nav

<PageTitle>Create user — admanager</PageTitle>
<h1>Create user</h1>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="panel" style="max-width:660px">
    <div class="grid2">
        <div>
            <label>Target OU</label>
            <select @bind="ouDn">
                <option value="@Ui.BaseDn">(domain root)</option>
                @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
                {
                    <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Layout template</label>
            <select @bind="templateSel" @bind:after="OnTemplateChange">
                <option value="">(default)</option>
                @foreach (var t in templates)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="tabbar">
    @for (int i = 0; i < Layout.Count; i++)
    {
        var idx = i;
        <button class="tabbtn @(sel == idx ? "on" : null)" @onclick="() => sel = idx">@Layout[idx].Title</button>
    }
</div>

<div class="panel" style="max-width:660px">
    @foreach (var f in CurrentTab.Fields)
    {
        var key = f.Key;
        var req = f.Required ? " *" : "";
        @if (key == "sAMAccountName")
        {
            <label>SAM account name@(req)</label>
            <input type="text" @bind="sam" placeholder="j.doe" disabled="@(f.Naming is { Length: > 0 })" />
            @if (f.Naming is { Length: > 0 }) { <div class="hint">Auto from first/last name.</div> }
        }
        else if (key == "__password")
        {
            <label>Password@(req)</label>
            <input type="password" @bind="password" />
            <div class="hint">Needed for an enabled account; per domain policy.</div>
        }
        else if (key == "__enabled")
        {
            <div class="checkbox"><input type="checkbox" id="en" @bind="enabled" /><label for="en">Enabled</label></div>
        }
        else if (key == "__mustChange")
        {
            <div class="checkbox"><input type="checkbox" id="mc" @bind="mustChange" /><label for="mc">Must change password at next logon</label></div>
        }
        else if (key == "__pwdNeverExpires")
        {
            <div class="checkbox"><input type="checkbox" id="pne" @bind="pwdNeverExpires" /><label for="pne">Password never expires</label></div>
        }
        else
        {
            <label>@FieldCatalog.Label(key)@(req)</label>
            <input type="text" value="@model.GetValueOrDefault(key)" @onchange="e => OnText(key, e)"
                   placeholder="@(key == "userPrincipalName" ? Upn : null)" disabled="@(f.Naming is { Length: > 0 })" />
            @if (f.Naming is { Length: > 0 }) { <div class="hint">Auto from first/last name.</div> }
            else if (key == "displayName") { <div class="hint">CN of the object. Empty → SAM account name.</div> }
        }
    }

    <div class="btnrow" style="margin-top:16px">
        <button class="primary" @onclick="Create" disabled="@string.IsNullOrWhiteSpace(sam)">Create user</button>
        <button @onclick='() => Nav.NavigateTo("users")'>Back to users</button>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<AdOuNode>? ous;
    private List<UserTemplate> templates = new();
    private UserTemplate? selectedTemplate;
    private string templateSel = "";
    private readonly List<TemplateTab> defaultLayout = TemplateDefaults.Create();

    private readonly Dictionary<string, string?> model = new(StringComparer.OrdinalIgnoreCase);
    private int sel;
    private string ouDn = "", sam = "", password = "";
    private bool enabled = true, mustChange, pwdNeverExpires;
    private string? banner; private bool ok;

    private List<TemplateTab> Layout => selectedTemplate?.Tabs is { Count: > 0 } t ? t : defaultLayout;
    private TemplateTab CurrentTab => Layout[Math.Min(sel, Layout.Count - 1)];
    private string Upn => (string.IsNullOrWhiteSpace(sam) ? "user" : sam) + "@" + Ui.Domain;

    protected override async Task OnInitializedAsync()
    {
        ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList();
        ouDn = ous.Any(o => o.Dn == Ui.UsersOu) ? Ui.UsersOu : (ous.Any(o => o.Dn == Ui.RootOu) ? Ui.RootOu : Ui.BaseDn);
        templates = (await Templates.ListAsync()).Where(t => t.Kind == "Create").ToList();
        ApplyTemplateDefaults();
    }

    private void OnTemplateChange()
    {
        selectedTemplate = Guid.TryParse(templateSel, out var id) ? templates.FirstOrDefault(t => t.Id == id) : null;
        sel = 0;
        // сброс + предзаполнение под новый шаблон
        model.Clear(); sam = ""; password = ""; enabled = true; mustChange = false; pwdNeverExpires = false;
        ApplyTemplateDefaults();
    }

    private IEnumerable<TemplateField> AllFields => Layout.SelectMany(t => t.Fields);

    private void ApplyTemplateDefaults()
    {
        foreach (var f in AllFields)
        {
            if (f.Key == "__enabled") enabled = f.Default is null ? true : f.Default == "true";
            else if (f.Key == "__mustChange") mustChange = f.Default == "true";
            else if (f.Key == "__pwdNeverExpires") pwdNeverExpires = f.Default == "true";
            else if (f.Key == "sAMAccountName") { if (!string.IsNullOrEmpty(f.Default)) sam = f.Default!; }
            else if (f.Key != "__password" && !string.IsNullOrEmpty(f.Default)) model[f.Key] = f.Default;
        }
        ApplyNaming();
    }

    private void OnText(string key, ChangeEventArgs e)
    {
        model[key] = e.Value?.ToString();
        ApplyNaming();
    }

    private void ApplyNaming()
    {
        var first = model.GetValueOrDefault("givenName");
        var last = model.GetValueOrDefault("sn");
        foreach (var f in AllFields.Where(x => x.Naming is { Length: > 0 }))
        {
            var v = NamingRules.Apply(f.Naming, first, last);
            if (v is null) continue;
            if (f.Key == "sAMAccountName") sam = v;
            else if (f.Key == "userPrincipalName") model["userPrincipalName"] = v + "@" + Ui.Domain;
            else model[f.Key] = v; // displayName и т.п.
        }
    }

    private List<string> MissingRequired()
    {
        var miss = new List<string>();
        foreach (var f in AllFields.Where(x => x.Required))
        {
            var ok = f.Key switch
            {
                "sAMAccountName" => !string.IsNullOrWhiteSpace(sam),
                "__password" => !string.IsNullOrWhiteSpace(password),
                _ => !string.IsNullOrWhiteSpace(model.GetValueOrDefault(f.Key)),
            };
            if (!ok) miss.Add(FieldCatalog.Label(f.Key));
        }
        return miss;
    }

    private async Task Create()
    {
        var miss = MissingRequired();
        if (miss.Count > 0) { ok = false; banner = "Required: " + string.Join(", ", miss); return; }

        var actor = CurrentUser.From(AuthState is null ? null : (await AuthState).User);
        var display = model.GetValueOrDefault("displayName");
        if (string.IsNullOrWhiteSpace(display)) display = sam;
        var upn = model.GetValueOrDefault("userPrincipalName");
        if (string.IsNullOrWhiteSpace(upn)) upn = Upn;

        var attrs = new Dictionary<string, string?>();
        foreach (var (k, v) in model)
        {
            if (FieldCatalog.IsSpecial(k) || k is "displayName" or "userPrincipalName") continue;
            if (!string.IsNullOrEmpty(v)) attrs[k] = v;
        }

        // Включённый аккаунт требует пароль; иначе создаём выключенным и предупреждаем (AD отклонит enable без пароля).
        var effectiveEnabled = enabled;
        var note = "";
        if (enabled && string.IsNullOrEmpty(password)) { effectiveEnabled = false; note = " (created disabled: no password provided)"; }

        var req = new CreateUserRequest(ouDn, sam.Trim(), display!.Trim(), upn!.Trim(),
            InitialPassword: string.IsNullOrEmpty(password) ? null : password, Enabled: effectiveEnabled, Attributes: attrs);

        var r = await Mgmt.CreateUserAsync(actor, req);
        ok = r.Success;
        banner = r.Success ? $"User '{sam}' created.{note}" : ("Error: " + r.Message);

        if (r.Success && (mustChange || pwdNeverExpires))
        {
            // Не собираем DN строкой (CN мог быть экранирован) — находим фактический DN по sAMAccountName.
            var found = (await Dir.SearchAsync(ouDn, sam.Trim()))
                .FirstOrDefault(x => string.Equals(x.SamAccountName, sam.Trim(), StringComparison.OrdinalIgnoreCase));
            if (found is null) { ok = false; banner += " Account options NOT applied: created user not found for follow-up."; }
            else
            {
                var opt = await Mgmt.SetAccountOptionsAsync(actor, found.Dn, new AccountOptions(
                    MustChangePasswordAtNextLogon: mustChange ? true : null,
                    PasswordNeverExpires: pwdNeverExpires ? true : null));
                if (!opt.Success) { ok = false; banner += " Account options failed: " + opt.Message; }
            }
        }
        if (r.Success) { sam = password = ""; model.Clear(); ApplyTemplateDefaults(); }
    }

    private static string Indent(int d) => new string(' ', d * 3);
}
