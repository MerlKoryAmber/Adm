@page "/users/create"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject IUserTemplateStore Templates
@inject UiOptions Ui
@inject NavigationManager Nav

<PageTitle>Create user — admanager</PageTitle>
<h1>Create user</h1>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="panel" style="max-width:660px">
    <div class="grid2">
        <div>
            <label>Target OU</label>
            <select @bind="ouDn">
                <option value="@Ui.BaseDn">(domain root)</option>
                @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
                {
                    <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Layout template</label>
            <select @bind="templateSel" @bind:after="OnTemplateChange">
                <option value="">(default)</option>
                @foreach (var t in templates)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="tabbar">
    @for (int i = 0; i < Layout.Count; i++)
    {
        var idx = i;
        <button class="tabbtn @(sel == idx ? "on" : null)" @onclick="() => sel = idx">@Layout[idx].Title</button>
    }
</div>

<div class="panel" style="max-width:660px">
    @foreach (var key in CurrentTab.Fields)
    {
        @if (key == "sAMAccountName")
        {
            <label>SAM account name *</label>
            <input type="text" @bind="sam" placeholder="j.doe" />
        }
        else if (key == "__password")
        {
            <label>Password</label>
            <input type="password" @bind="password" />
            <div class="hint">Needed for an enabled account; per domain policy.</div>
        }
        else if (key == "__enabled")
        {
            <div class="checkbox"><input type="checkbox" id="en" @bind="enabled" /><label for="en">Enabled</label></div>
        }
        else if (key == "__mustChange")
        {
            <div class="checkbox"><input type="checkbox" id="mc" @bind="mustChange" /><label for="mc">Must change password at next logon</label></div>
        }
        else if (key == "__pwdNeverExpires")
        {
            <div class="checkbox"><input type="checkbox" id="pne" @bind="pwdNeverExpires" /><label for="pne">Password never expires</label></div>
        }
        else
        {
            <label>@FieldCatalog.Label(key)</label>
            <input type="text" value="@model.GetValueOrDefault(key)" @onchange="e => model[key] = e.Value?.ToString()"
                   placeholder="@(key == "userPrincipalName" ? Upn : null)" />
            @if (key == "displayName")
            {
                <div class="hint">CN of the object. Empty → SAM account name.</div>
            }
        }
    }

    <div class="btnrow" style="margin-top:16px">
        <button class="primary" @onclick="Create" disabled="@string.IsNullOrWhiteSpace(sam)">Create user</button>
        <button @onclick='() => Nav.NavigateTo("users")'>Back to users</button>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly HashSet<string> Special = new(StringComparer.OrdinalIgnoreCase)
        { "sAMAccountName", "__password", "__enabled", "__mustChange", "__pwdNeverExpires" };

    private List<AdOuNode>? ous;
    private List<UserTemplate> templates = new();
    private UserTemplate? selectedTemplate;
    private string templateSel = "";
    private List<TemplateTab> defaultLayout = TemplateDefaults.Create();

    private readonly Dictionary<string, string?> model = new(StringComparer.OrdinalIgnoreCase);
    private int sel;
    private string ouDn = "", sam = "", password = "";
    private bool enabled = true, mustChange, pwdNeverExpires;
    private string? banner; private bool ok;

    private List<TemplateTab> Layout => selectedTemplate?.Tabs is { Count: > 0 } t ? t : defaultLayout;
    private TemplateTab CurrentTab => Layout[Math.Min(sel, Layout.Count - 1)];
    private string Upn => (string.IsNullOrWhiteSpace(sam) ? "user" : sam) + "@" + Ui.Domain;

    protected override async Task OnInitializedAsync()
    {
        ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList();
        ouDn = ous.Any(o => o.Dn == Ui.UsersOu) ? Ui.UsersOu : (ous.Any(o => o.Dn == Ui.RootOu) ? Ui.RootOu : Ui.BaseDn);
        templates = (await Templates.ListAsync()).Where(t => t.Kind == "Create").ToList();
    }

    private void OnTemplateChange()
    {
        selectedTemplate = Guid.TryParse(templateSel, out var id) ? templates.FirstOrDefault(t => t.Id == id) : null;
        sel = 0;
    }

    private async Task Create()
    {
        var actor = CurrentUser.From(AuthState is null ? null : (await AuthState).User);
        var display = model.GetValueOrDefault("displayName");
        if (string.IsNullOrWhiteSpace(display)) display = sam;
        var upn = model.GetValueOrDefault("userPrincipalName");
        if (string.IsNullOrWhiteSpace(upn)) upn = Upn;

        var attrs = new Dictionary<string, string?>();
        foreach (var (k, v) in model)
        {
            if (Special.Contains(k) || k is "displayName" or "userPrincipalName") continue;
            if (!string.IsNullOrEmpty(v)) attrs[k] = v;
        }

        var req = new CreateUserRequest(ouDn, sam.Trim(), display!.Trim(), upn!.Trim(),
            InitialPassword: string.IsNullOrEmpty(password) ? null : password, Enabled: enabled, Attributes: attrs);

        var r = await Mgmt.CreateUserAsync(actor, req);
        ok = r.Success;
        banner = r.Success ? $"User '{sam}' created." : ("Error: " + r.Message);

        if (r.Success && (mustChange || pwdNeverExpires))
        {
            var dn = $"CN={display.Trim()},{ouDn}";
            await Mgmt.SetAccountOptionsAsync(actor, dn, new AccountOptions(
                MustChangePasswordAtNextLogon: mustChange ? true : null,
                PasswordNeverExpires: pwdNeverExpires ? true : null));
        }
        if (r.Success) { sam = password = ""; model.Clear(); }
    }

    private static string Indent(int d) => new string(' ', d * 3);
}
