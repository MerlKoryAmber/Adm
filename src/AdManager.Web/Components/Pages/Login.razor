@page "/login"
@layout LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Nav

<PageTitle>Sign in — admanager</PageTitle>

<div class="login-card">
    <div class="login-logo">ADManager<span>·lab</span></div>
    <p class="login-sub">Sign in with a local panel account. Domain users can use Windows single sign-on.</p>

    @if (HasError)
    {
        <div class="banner err">Invalid user name or password.</div>
    }

    <form method="post" action="/auth/login">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <label>User name</label>
        <input type="text" name="user" autofocus placeholder="admin" />
        <label>Password</label>
        <input type="password" name="pass" />
        <button class="primary" type="submit" style="margin-top:14px;width:100%">Sign in</button>
    </form>

    <div class="hint" style="margin-top:14px">Default local account on a fresh install: <b>admin</b> / <b>admin</b>. Change it in Administration → Panel users.</div>
</div>

@code {
    private bool HasError;
    private string ReturnUrl = "/";

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        HasError = q.TryGetValue("error", out var e) && e == "1";
        if (q.TryGetValue("returnUrl", out var r) && !string.IsNullOrEmpty(r) && r.ToString().StartsWith('/'))
            ReturnUrl = r!;
    }
}
