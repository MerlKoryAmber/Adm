@page "/automation"
@inject IAutomationScheduler Scheduler
@inject IAutomationStore Store
@inject IReportService ReportSvc
@inject IAdDirectory Dir
@inject UiOptions Ui

<PageTitle>Automation — admanager</PageTitle>
<div class="pagehead">
    <h1>Scheduled Automation</h1>
    <span class="grow"></span>
    @if (editing is null)
    {
        <button class="primary" @onclick="NewAutomation">+ Create New Automation</button>
    }
</div>
<RequireAccess Permissions="new[] { Permission.ManageAutomation }">
<p class="subtitle">Automatically execute AD tasks at a pre-specified time. Each run goes through RBAC + audit. No approval workflow.</p>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

@* ---------------- Список (скрыт, пока открыта форма) ---------------- *@
@if (editing is null)
{
<div class="panel">
    <div class="panelhead"><h3>Automations</h3><span class="grow"></span>
        <button @onclick="Reload">Refresh</button>
    </div>
    @if (data is null) { <p>Loading…</p> }
    else if (data.Definitions.Count == 0) { <p class="muted">No automations.</p> }
    else
    {
        <div style="overflow-x:auto">
        <table>
            <thead><tr>
                <th>Automation Name</th><th>Request Type</th><th>Criteria</th><th>Category</th>
                <th>Time Summary</th><th>Last run (MSK)</th><th>Enabled</th><th></th>
            </tr></thead>
            <tbody>
                @foreach (var a in data.Definitions)
                {
                    <tr>
                        <td><b>@a.Name</b>@if (!string.IsNullOrEmpty(a.Description)) { <div class="hint">@a.Description</div> }</td>
                        <td>@AutomationTaskTypes.Label(a.TaskType)</td>
                        <td>@(ReportSvc.Find(a.SourceReportKey)?.Title ?? "—")</td>
                        <td>User Automation</td>
                        <td>@a.Schedule.Summary()</td>
                        <td>@(a.LastRunMsk?.ToString("yyyy-MM-dd HH:mm") ?? "—")@if (!string.IsNullOrEmpty(a.LastRunResult)) { <div class="hint">@a.LastRunResult</div> }</td>
                        <td><span class="badge @(a.Enabled ? "ok" : "off")">@(a.Enabled ? "On" : "Off")</span></td>
                        <td style="white-space:nowrap">
                            <button @onclick="() => Edit(a)">Edit</button>
                            <button @onclick="() => Trigger(a.Id)">Run Now</button>
                            <button @onclick="() => Toggle(a)">@(a.Enabled ? "Disable" : "Enable")</button>
                            <button class="danger" @onclick="() => Delete(a.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>
}

@* ---------------- Форма Modify (вместо списка) ---------------- *@
@if (editing is not null)
{
    <div class="panel" style="margin-top:18px;max-width:820px">
        <h3>@(isNew ? "Create Automation" : "Modify Automation")</h3>

        <div class="grid2">
            <div>
                <label>Automation Name *</label>
                <input type="text" @bind="editing.Name" placeholder="Add to group - New users" />
            </div>
            <div>
                <label>Description</label>
                <input type="text" @bind="editing.Description" placeholder="What this automation does" />
            </div>
        </div>

        <hr />
        <div class="treegroup" style="padding-left:0">Task to automate</div>
        <label>Automation Task</label>
        <select @bind="editing.TaskType">
            @foreach (var (type, lbl) in AutomationTaskTypes.All) { <option value="@type">@lbl</option> }
        </select>

        @* параметры задачи *@
        @if (editing.TaskType is AutomationTaskTypes.AddToGroup or AutomationTaskTypes.RemoveFromGroup)
        {
            <label>Select Group</label>
            <select @bind="groupDn">
                <option value="">— select group —</option>
                @foreach (var g in groups ?? Enumerable.Empty<AdGroupSummary>()) { <option value="@g.Dn">@g.Name</option> }
            </select>
        }
        else if (editing.TaskType == AutomationTaskTypes.MoveUsers)
        {
            <label>Target OU</label>
            <select @bind="targetOu">
                <option value="">— select OU —</option>
                @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>()) { <option value="@o.Dn">@OuIndent(o.Depth)@o.Name</option> }
            </select>
        }

        <hr />
        <div class="treegroup" style="padding-left:0">Select objects</div>
        <label>From Report</label>
        <select @bind="editing.SourceReportKey">
            <option value="">— select report —</option>
            @foreach (var grp in ReportSvc.Catalog.GroupBy(r => r.Category))
            {
                <optgroup label="@grp.Key">
                    @foreach (var r in grp) { <option value="@r.Key">@r.Title</option> }
                </optgroup>
            }
        </select>
        <div class="hint">The task runs on the objects returned by this report.</div>

        @* Refine Result — доп-условия поверх отчёта *@
        <label style="margin-top:10px;display:block">Refine result</label>
        @foreach (var (cond, i) in editing.Refine.Select((c, i) => (c, i)))
        {
            <div style="display:flex;gap:8px;align-items:center;margin:4px 0">
                <span class="muted" style="width:18px">@(i + 1).</span>
                <select @bind="cond.Field" style="min-width:150px">
                    <option value="">— field —</option>
                    <option value="@RefineFields.OuName">OU Name</option>
                    @foreach (var col in RefineColumns()) { <option value="@col">@col</option> }
                </select>
                <select @bind="cond.Operator">
                    <option value="@RefineOperator.Is">Is</option>
                    <option value="@RefineOperator.Contains">Contains</option>
                    <option value="@RefineOperator.IsNot">Is not</option>
                    <option value="@RefineOperator.NotContains">Not Contains</option>
                </select>
                <input type="text" @bind="cond.Value" placeholder="value" />
                <button class="linkbtn" @onclick="() => editing.Refine.RemoveAt(i)">✕</button>
            </div>
        }
        <div class="btnrow"><button @onclick="() => editing.Refine.Add(new RefineCondition())">+ Add condition</button></div>
        @if (editing.Refine.Count > 0) { <div class="hint">All conditions must match (AND).</div> }

        <div class="checkbox" style="margin-top:8px"><input type="checkbox" id="excl" @bind="editing.ExcludePreviouslyModified" /><label for="excl">Exclude objects modified by the previous execution of this automation</label></div>

        <hr />
        <div class="treegroup" style="padding-left:0">Execution time</div>
        <label>Run at</label>
        <select @bind="editing.Schedule.Kind">
            @foreach (var k in Enum.GetValues<ScheduleKind>()) { <option value="@k">@k</option> }
        </select>

        <div style="display:flex;gap:12px;align-items:flex-end;margin-top:6px;flex-wrap:wrap">
            @switch (editing.Schedule.Kind)
            {
                case ScheduleKind.Hourly:
                    <div><label>For Each (hrs)</label><input type="number" min="1" @bind="editing.Schedule.EveryHours" style="width:90px" /></div>
                    break;
                case ScheduleKind.Daily:
                    @HourMinute
                    break;
                case ScheduleKind.Weekly:
                    <div><label>Day</label>
                        <select @bind="editing.Schedule.DayOfWeek">@foreach (var d in Enum.GetValues<DayOfWeek>()) { <option value="@d">@d</option> }</select></div>
                    @HourMinute
                    break;
                case ScheduleKind.Monthly:
                    <div><label>Day of month</label><input type="number" min="1" max="31" @bind="editing.Schedule.DayOfMonth" style="width:90px" /></div>
                    @HourMinute
                    break;
                case ScheduleKind.Once:
                    <div><label>Run at (MSK)</label><input type="datetime-local" @bind="onceAt" /></div>
                    break;
            }
        </div>

        <hr />
        <div class="checkbox"><input type="checkbox" id="en" @bind="editing.Enabled" /><label for="en">Enabled</label></div>
        <div class="btnrow">
            <button class="primary" @onclick="Save" disabled="@(string.IsNullOrWhiteSpace(editing.Name) || string.IsNullOrEmpty(editing.SourceReportKey))">@(isNew ? "Create" : "Update")</button>
            <button @onclick="() => editing = null">Cancel</button>
        </div>
    </div>
}
</RequireAccess>

@code {
    private AutomationData? data;
    private List<AdOuNode>? ous;
    private List<AdGroupSummary>? groups;
    private string? banner; private bool ok;

    private AutomationDefinition? editing;
    private bool isNew;
    private string groupDn = "", targetOu = "";
    private DateTime onceAt = DateTime.Now.AddHours(1);

    private RenderFragment HourMinute => __builder =>
    {
        <div><label>Hour</label><input type="number" min="0" max="23" @bind="editing!.Schedule.Hour" style="width:80px" /></div>
        <div><label>Minute</label><input type="number" min="0" max="59" @bind="editing!.Schedule.Minute" style="width:80px" /></div>
    };

    protected override async Task OnInitializedAsync()
    {
        try { ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList(); } catch { ous = new(); }
        try { groups = (await Dir.ListGroupsAsync(Ui.BaseDn, subtree: true)).ToList(); } catch { groups = new(); }
        await Reload();
    }

    private async Task Reload() => data = await Store.LoadAsync();

    private void NewAutomation()
    {
        editing = new AutomationDefinition { TaskType = AutomationTaskTypes.AddToGroup };
        isNew = true; groupDn = ""; targetOu = ""; onceAt = DateTime.Now.AddHours(1); banner = null;
    }

    private void Edit(AutomationDefinition a)
    {
        // редактируем копию
        editing = new AutomationDefinition
        {
            Id = a.Id, Name = a.Name, Description = a.Description, Enabled = a.Enabled,
            TaskType = a.TaskType, SourceReportKey = a.SourceReportKey,
            Parameters = new(a.Parameters),
            Refine = a.Refine.Select(c => new RefineCondition { Field = c.Field, Operator = c.Operator, Value = c.Value }).ToList(),
            ExcludePreviouslyModified = a.ExcludePreviouslyModified,
            LastProcessedDns = new(a.LastProcessedDns),
            Schedule = new AutomationSchedule
            {
                Kind = a.Schedule.Kind, EveryHours = a.Schedule.EveryHours, Hour = a.Schedule.Hour,
                Minute = a.Schedule.Minute, DayOfWeek = a.Schedule.DayOfWeek, DayOfMonth = a.Schedule.DayOfMonth,
                RunAtMsk = a.Schedule.RunAtMsk,
            },
            LastRunMsk = a.LastRunMsk, LastRunResult = a.LastRunResult,
        };
        isNew = false;
        groupDn = a.Parameters.GetValueOrDefault("groupDn", "");
        targetOu = a.Parameters.GetValueOrDefault("targetOu", "");
        onceAt = a.Schedule.RunAtMsk ?? DateTime.Now.AddHours(1);
        banner = null;
    }

    private async Task Save()
    {
        if (editing is null) return;
        // собрать параметры задачи
        editing.Parameters = new();
        if (editing.TaskType is AutomationTaskTypes.AddToGroup or AutomationTaskTypes.RemoveFromGroup)
        {
            if (string.IsNullOrEmpty(groupDn)) { Show("Select a group.", false); return; }
            editing.Parameters["groupDn"] = groupDn;
        }
        else if (editing.TaskType == AutomationTaskTypes.MoveUsers)
        {
            if (string.IsNullOrEmpty(targetOu)) { Show("Select target OU.", false); return; }
            editing.Parameters["targetOu"] = targetOu;
        }
        if (editing.Schedule.Kind == ScheduleKind.Once) editing.Schedule.RunAtMsk = onceAt;

        // отбросить пустые Refine-условия (без поля)
        editing.Refine = editing.Refine.Where(c => !string.IsNullOrEmpty(c.Field)).ToList();

        await Scheduler.RegisterAsync(editing);
        Show(isNew ? "Automation created." : "Automation updated.", true);
        editing = null;
        await Reload();
    }

    private async Task Toggle(AutomationDefinition a)
    {
        a.Enabled = !a.Enabled;
        await Scheduler.RegisterAsync(a);
        await Reload();
    }

    private async Task Trigger(Guid id) { await Scheduler.TriggerNowAsync(id); Show("Run triggered.", true); await Reload(); }

    private async Task Delete(Guid id)
    {
        var d = await Store.LoadAsync();
        d.Definitions.RemoveAll(x => x.Id == id);
        await Store.SaveAsync(d);
        Show("Deleted.", true); await Reload();
    }

    private void Show(string m, bool success) { ok = success; banner = m; }
    private static string OuIndent(int d) => string.Concat(Enumerable.Repeat(' ', d * 3)) + (d > 0 ? "└ " : "");

    /// <summary>Колонки отчёта для Refine — по типу объекта выбранного отчёта.</summary>
    private string[] RefineColumns()
    {
        var def = editing is null ? null : ReportSvc.Find(editing.SourceReportKey);
        return def?.ObjectType switch
        {
            ReportObjectType.User    => new[] { "Display name", "Account", "UPN", "Email", "Status" },
            ReportObjectType.Group   => new[] { "Name", "Account", "Members" },
            ReportObjectType.Contact => new[] { "Name", "Email" },
            ReportObjectType.Ou      => new[] { "Name", "Depth" },
            _ => Array.Empty<string>(),
        };
    }
}
