@page "/password-expiry"
@inject IPasswordExpiryService Expiry
@inject ISettingsStore Store
@inject PasswordExpiryNotifier Notifier

<PageTitle>Password expiry — admanager</PageTitle>
<h1>Password expiry</h1>
<p class="subtitle">Email reminders for users whose Active Directory password expires soon (msDS-UserPasswordExpiryTimeComputed).</p>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

@if (model is null)
{
    <p>Loading…</p>
}
else
{
    <div class="panel" style="max-width:760px">
        <h3>Policy</h3>
        <div class="checkbox"><input type="checkbox" id="en" @bind="model.Enabled" /><label for="en">Enable daily reminders</label></div>
        <div class="hint">When enabled, a daily job emails users on each configured trigger day before expiry.</div>

        <label>Run hour (MSK)</label>
        <input type="number" style="max-width:120px" @bind="model.RunHourMsk" placeholder="8" />
        <div class="hint">Hour of day (0–23, MSK) the daily job runs. SMTP is configured under Settings.</div>
    </div>

    <div class="panel" style="max-width:760px;margin-top:16px">
        <div class="toolbar">
            <h3 style="margin:0">Triggers</h3>
            <span class="grow"></span>
            <button @onclick="AddTrigger">+ Add trigger</button>
        </div>
        <div class="hint" style="margin-bottom:8px">Each trigger fires when a user's password is exactly N days from expiry. Placeholders: {name}, {days}, {date}.</div>

        @if (model.Triggers.Count == 0)
        {
            <p class="muted">No triggers. Add at least one.</p>
        }
        else
        {
            @foreach (var t in model.Triggers)
            {
                var tt = t;
                <div style="border:1px solid var(--border);border-radius:6px;padding:10px;margin-bottom:10px">
                    <div class="toolbar">
                        <label style="margin:0">Days before expiry</label>
                        <input type="number" style="max-width:100px" @bind="tt.DaysBefore" />
                        <span class="grow"></span>
                        <button class="linkbtn danger" @onclick="() => RemoveTrigger(tt)">Remove</button>
                    </div>
                    <label>Subject</label>
                    <input type="text" @bind="tt.Subject" />
                    <label>Body</label>
                    <textarea rows="5" style="width:100%" @bind="tt.Body"></textarea>
                </div>
            }
        }
    </div>

    <div class="btnrow" style="margin-top:16px;max-width:760px">
        <button class="primary" @onclick="Save">Save policy</button>
    </div>

    <div class="panel" style="margin-top:24px">
        <div class="toolbar">
            <h3 style="margin:0">Preview / manual run</h3>
            <label style="margin:0 0 0 12px">Within days</label>
            <input type="number" style="max-width:100px" @bind="withinDays" />
            <button @onclick="LoadList">Refresh</button>
            <span class="grow"></span>
            <button class="primary" @onclick="RunNow" disabled="@running">@(running ? "Running…" : "Run reminders now")</button>
        </div>
        @if (lastRun is not null) { <div class="hint" style="margin-top:6px">Last run: @lastRun</div> }
    </div>

    @if (users is not null)
    {
        <div class="gridpanel">
            <div style="overflow-x:auto">
                <table>
                    <thead>
                        <tr><th>Display name</th><th>Email</th><th>Expires (UTC)</th><th>Days left</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var u in users)
                        {
                            <tr>
                                <td>@u.DisplayName</td>
                                <td>@(string.IsNullOrWhiteSpace(u.Mail) ? "— no email —" : u.Mail)</td>
                                <td>@u.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge @(u.DaysLeft <= 1 ? "warn" : "ok")">@u.DaysLeft</span></td>
                            </tr>
                        }
                        @if (users.Count == 0)
                        {
                            <tr><td colspan="4" class="muted">No users expiring within @withinDays day(s).</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="pager"><span>@users.Count user(s)</span></div>
    }
}

@code {
    private PasswordExpiryPolicy? model;
    private IReadOnlyList<ExpiringUser>? users;
    private int withinDays = 14;
    private bool running;
    private string? lastRun;
    private string? banner; private bool ok;

    protected override async Task OnInitializedAsync()
    {
        var s = await Store.LoadAsync();
        model = s.PasswordExpiry;
        lastRun = s.LastRunResult;
        await LoadList();
    }

    private void AddTrigger() => model!.Triggers.Add(new ExpiryTrigger { DaysBefore = 1 });
    private void RemoveTrigger(ExpiryTrigger t) => model!.Triggers.Remove(t);

    private async Task LoadList()
    {
        try { users = await Expiry.ListExpiringAsync(withinDays); }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; users = new List<ExpiringUser>(); }
    }

    private async Task Save()
    {
        if (model is null) return;
        model.Triggers = model.Triggers.OrderByDescending(t => t.DaysBefore).ToList();
        try
        {
            var s = await Store.LoadAsync();
            s.PasswordExpiry = model;
            await Store.SaveAsync(s);
            ok = true; banner = "Policy saved.";
        }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; }
    }

    private async Task RunNow()
    {
        running = true;
        try { var r = await Notifier.RunNowAsync(); ok = true; banner = r; lastRun = r; }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; }
        finally { running = false; }
    }
}
