@page "/groups"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject UiOptions Ui
@inject NavigationManager Nav

<PageTitle>Group Management — admanager</PageTitle>
<h1>Modify groups</h1>
<RequireAccess Permissions="new[] { Permission.CreateGroup, Permission.ManageGroupMembership }">

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="toolbar">
    <input class="searchbox" type="text" placeholder="Search name / account…" @bind="search" @bind:event="oninput" @bind:after="ReloadFirst" />
    <span class="grow"></span>
    <button @onclick='() => Nav.NavigateTo("groups/create")'>+ Create</button>
    <button @onclick="Load">Refresh</button>
</div>

@if (selected.Count > 0)
{
    <div class="bulkbar">
        <span class="count">@selected.Count selected</span>
        <span style="width:220px;display:inline-block">
            <OuPicker Value="@bulkMoveTo" ValueChanged="v => bulkMoveTo = v" Placeholder="move to…" />
        </span>
        <button @onclick="BulkMove" disabled="@string.IsNullOrEmpty(bulkMoveTo)">Move</button>
        @if (!confirmBulkDelete) { <button class="danger" @onclick="() => confirmBulkDelete = true">Delete…</button> }
        else
        {
            <button class="danger" @onclick="BulkDelete">Confirm delete @selected.Count</button>
            <button @onclick="() => confirmBulkDelete = false">Cancel</button>
        }
        <button class="linkbtn" @onclick="ClearSel">clear</button>
    </div>
}

@if (groups is null)
{
    <p>Loading…</p>
}
else
{
    var pageItems = groups;
    var pages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));

    <div class="gridpanel">
        <div style="overflow-x:auto">
            <table>
                <thead>
                    <tr>
                        <th class="chk"><input type="checkbox" checked="@AllOnPageSelected(pageItems)" @onchange="e => TogglePage(pageItems, e)" /></th>
                        <th>Name</th><th>Account</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in pageItems)
                    {
                        var gg = g;
                        <tr>
                            <td class="chk"><input type="checkbox" checked="@selected.Contains(gg.Dn)" @onchange="e => ToggleOne(gg.Dn, e)" /></td>
                            <td>@gg.Name</td>
                            <td>@gg.SamAccountName</td>
                            <td><button @onclick="() => Modify(gg)">Modify</button></td>
                        </tr>
                    }
                    @if (pageItems.Count == 0) { <tr><td colspan="4" class="muted" style="padding:12px">No groups match.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>

    <div class="pager">
        <span>@total group(s)</span>
        <button @onclick="() => Go(0)" disabled="@(page == 0)">« First</button>
        <button @onclick="() => Go(page - 1)" disabled="@(page == 0)">‹ Prev</button>
        <span>Page @(page + 1) / @pages</span>
        <button @onclick="() => Go(page + 1)" disabled="@(page >= pages - 1)">Next ›</button>
        <button @onclick="() => Go(pages - 1)" disabled="@(page >= pages - 1)">Last »</button>
    </div>
}
</RequireAccess>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const int PageSize = 50;
    private List<AdGroupSummary>? groups;   // текущая страница
    private int total;
    private readonly HashSet<string> selected = new();
    private string search = "", bulkMoveTo = "";
    private int page;
    private string? banner; private bool ok; private bool confirmBulkDelete;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task ReloadFirst() { page = 0; await Load(); }
    private async Task Go(int p) { page = Math.Max(0, p); await Load(); }

    private async Task Load()
    {
        try
        {
            var res = await Dir.ListGroupsPagedAsync(Ui.BaseDn, subtree: true, search, page * PageSize, PageSize);
            groups = res.Items.ToList(); total = res.Total;
            var pages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
            if (page >= pages) { page = pages - 1; if (page < 0) page = 0; }
        }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; groups = new(); total = 0; }
    }

    private void Modify(AdGroupSummary g) => Nav.NavigateTo($"groups/modify?dn={Uri.EscapeDataString(g.Dn)}");

    private bool AllOnPageSelected(List<AdGroupSummary> pageItems) => pageItems.Count > 0 && pageItems.All(g => selected.Contains(g.Dn));
    private void TogglePage(List<AdGroupSummary> pageItems, ChangeEventArgs e)
    {
        var on = (bool)(e.Value ?? false);
        foreach (var g in pageItems) { if (on) selected.Add(g.Dn); else selected.Remove(g.Dn); }
    }
    private void ToggleOne(string dn, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) selected.Add(dn); else selected.Remove(dn); }
    private void ClearSel() { selected.Clear(); confirmBulkDelete = false; }

    private async Task BulkMove()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Mgmt.MoveAsync(actor, dn, bulkMoveTo); if (r.Success) okc++; else fail++; }
        bulkMoveTo = ""; ok = fail == 0; banner = $"Move: {okc} ok, {fail} failed."; selected.Clear(); confirmBulkDelete = false; await Load();
    }

    private async Task BulkDelete()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Mgmt.DeleteObjectAsync(actor, dn); if (r.Success) okc++; else fail++; }
        ok = fail == 0; banner = $"Delete: {okc} ok, {fail} failed."; selected.Clear(); confirmBulkDelete = false; await Load();
    }

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }
}
