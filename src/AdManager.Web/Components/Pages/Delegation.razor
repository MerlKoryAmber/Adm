@page "/delegation"
@inject IRbacStore Store
@inject IAdDirectory Dir
@inject IUserTemplateStore Templates
@inject UiOptions Ui
@inject IAuditLog Audit

<PageTitle>Delegation — admanager</PageTitle>
<h1>Delegation</h1>
<RequireAccess Permissions="new[] { Permission.ManageDelegation }">
<p class="subtitle">Help-desk roles (task sets) → scopes (OUs) → assignments (technician SID / AD group SID). Super-admins bypass.</p>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

@if (cfg is null)
{
    <p>Loading…</p>
}
else
{
    @if (section == "roles")
    {
        <div class="panel" id="roles">
            <h3>Roles</h3>
            @if (cfg.Roles.Count == 0) { <p class="muted">No roles.</p> }
            else
            {
                <table><tbody>
                    @foreach (var r in cfg.Roles)
                    {
                        var inUse = cfg.Assignments.Any(a => a.RoleId == r.Id);
                        <tr><td><b>@r.Name</b> @if (r.IsSuperAdmin) { <span class="badge warn">Super admin</span> } @if (r.IsBuiltin) { <span class="badge">Built-in</span> }
                            <div class="hint">@(r.IsSuperAdmin ? "Full access (bypasses scope)" : string.Join(", ", r.Permissions.Select(PermissionLabel)))</div>
                            @if (r.Permissions.Contains(Permission.CreateUser) && r.CreateUserFields.Count > 0)
                            { <div class="hint">Create fields: @string.Join(", ", r.CreateUserFields.Select(FieldCatalog.Label))</div> }
                            @if (r.Permissions.Contains(Permission.ModifyAttributes) && r.ModifyUserFields.Count > 0)
                            { <div class="hint">Modify fields: @string.Join(", ", r.ModifyUserFields.Select(FieldCatalog.Label))</div> }
                            </td>
                            <td>
                                @if (r.IsBuiltin) { <span class="hint">Built-in</span> }
                                else if (inUse) { <span class="hint" title="Remove assignments first">In use</span> }
                                else { <button class="danger" @onclick="() => DeleteRole(r.Id)">Delete</button> }
                            </td></tr>
                    }
                </tbody></table>
            }
            <hr />
            <h3>New role</h3>
            <label>Name</label><input type="text" @bind="roleName" placeholder="Help Desk L1" />

            <div class="checkbox" style="margin-top:10px"><input type="checkbox" id="super" @bind="roleIsSuper" /><label for="super">Super admin (full access, bypasses scope)</label></div>
            <div class="hint">Grants complete access like a built-in administrator. Assign to your admins. Individual permissions below are ignored for a super-admin role.</div>

            @if (!roleIsSuper)
            {
                // активная вкладка по умолчанию — первая группа
                if (string.IsNullOrEmpty(permTab)) { permTab = PermissionGroups[0].Group; }
                <label style="margin-top:14px;display:block">Permissions</label>
                <div class="subtabs" style="flex-wrap:wrap">
                    @foreach (var (group, perms) in PermissionGroups)
                    {
                        var count = perms.Count(rolePerms.Contains);
                        <button class="subtab @(permTab == group ? "active" : "")" @onclick="() => permTab = group">
                            @group @if (count > 0) { <span class="badge">@count</span> }
                        </button>
                    }
                </div>

                @foreach (var (group, perms) in PermissionGroups)
                {
                    @if (permTab == group)
                    {
                        <div style="margin-top:4px">
                            @foreach (var p in perms)
                            {
                                <label style="font-weight:400;display:flex;gap:6px;align-items:center;margin:4px 0">
                                    <input type="checkbox" checked="@rolePerms.Contains(p)" @onchange="e => TogglePerm(p, e)" /> @PermissionLabel(p)
                                </label>
                            }
                        </div>
                    }
                }

                @if (rolePerms.Contains(Permission.CreateUser))
                {
                    <FieldPicker Title="Create user — allowed fields" Hint="Leave all unchecked to allow every field." Selected="createFields" />
                }
                @if (rolePerms.Contains(Permission.ModifyAttributes))
                {
                    <FieldPicker Title="Modify users — allowed fields" Hint="Leave all unchecked to allow every field." Selected="modifyFields" />
                }
            }

            <div class="btnrow"><button class="primary" @onclick="CreateRole" disabled="@(string.IsNullOrWhiteSpace(roleName) || (rolePerms.Count == 0 && !roleIsSuper))">Create role</button></div>
        </div>
    }

    @if (section == "scopes")
    {
        <div class="panel" id="scopes">
            <h3>Scopes</h3>
            @if (cfg.Scopes.Count == 0) { <p class="muted">No scopes.</p> }
            else
            {
                <table><tbody>
                    @foreach (var s in cfg.Scopes)
                    {
                        <tr><td><b>@s.Name</b><div class="hint">@string.Join("; ", s.OuDns)@(s.IncludeSubtree ? " (subtree)" : "")</div></td>
                            <td><button class="danger" @onclick="() => DeleteScope(s.Id)">Delete</button></td></tr>
                    }
                </tbody></table>
            }
            <hr />
            <h3>New scope</h3>
            <label>Name</label><input type="text" @bind="scopeName" placeholder="Sales OU" />
            <div style="display:flex;align-items:center;gap:10px;margin-top:6px">
                <label style="margin:0">OUs</label>
                <span class="hint" style="margin:0">@scopeOus.Count selected</span>
                <span class="grow"></span>
                <button type="button" @onclick="() => { scopeOus.Clear(); }">Clear</button>
            </div>
            <OuTree Selectable="true" Selected="scopeOus" OnSelectionChanged="StateHasChanged" />
            <div class="hint" style="margin-top:6px">Select a parent OU to include all OUs under it; uncheck any child to exclude it.</div>
            <div class="btnrow"><button class="primary" @onclick="CreateScope" disabled="@(string.IsNullOrWhiteSpace(scopeName) || scopeOus.Count == 0)">Create scope</button></div>
        </div>
    }

    @if (section == "assignments")
    {
    <div class="panel" id="assignments">
        <h3>Assignments</h3>
        @if (cfg.Assignments.Count == 0) { <p class="muted">No assignments.</p> }
        else
        {
            <table>
                <thead><tr><th>Subject</th><th>Type</th><th>Role</th><th>Scope</th><th>Templates</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in cfg.Assignments)
                    {
                        <tr>
                            <td>@(string.IsNullOrEmpty(a.SubjectName) ? a.SubjectSid : a.SubjectName)<div class="hint" style="word-break:break-all">@a.SubjectSid</div></td>
                            <td>@a.SubjectType</td>
                            <td>@RoleName(a.RoleId)</td>
                            <td>@ScopeName(a.ScopeId)</td>
                            <td>
                                @if (a.CreateTemplateId is { } ct) { <div class="hint">Create: @TemplateName(ct)</div> }
                                @if (a.ModifyTemplateId is { } mt) { <div class="hint">Modify: @TemplateName(mt)</div> }
                                @if (a.CreateTemplateId is null && a.ModifyTemplateId is null) { <span class="muted">—</span> }
                            </td>
                            <td><button class="danger" @onclick="() => DeleteAssignment(a.Id)">Delete</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <hr />
        <h3>New assignment</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px">
            <div style="grid-column:1 / -1">
                <label>Subject (user or group)</label>
                @if (!string.IsNullOrEmpty(asgName))
                {
                    <div class="toolbar" style="margin:4px 0">
                        <span class="grow">@asgName <span class="fkey">@asgType · @asgSid</span></span>
                        <button class="linkbtn danger" @onclick="ClearSubject">Clear</button>
                    </div>
                }
                else
                {
                    <div class="toolbar" style="margin:4px 0">
                        <input class="grow" type="text" placeholder="find user or group by name…" @bind="subjSearch" @bind:event="oninput" />
                        <button @onclick="FindSubject" disabled="@string.IsNullOrWhiteSpace(subjSearch)">Find</button>
                    </div>
                    @if (subjResults is { Count: > 0 })
                    {
                        <div class="fieldlist">
                            @foreach (var s in subjResults)
                            {
                                var ss = s;
                                <div class="fieldrow"><span class="fname">@ss.Name</span><span class="fkey">@ss.ObjectClass</span><span class="grow"></span><button class="linkbtn" @onclick="() => PickSubject(ss)">Select</button></div>
                            }
                        </div>
                    }
                }
            </div>
            <div>
                <label>Role</label>
                <select @bind="asgRole">
                    <option value="">— role —</option>
                    @foreach (var r in cfg.Roles) { <option value="@r.Id">@r.Name</option> }
                </select>
            </div>
            <div>
                <label>Scope</label>
                <select @bind="asgScope">
                    <option value="">— scope —</option>
                    @foreach (var s in cfg.Scopes) { <option value="@s.Id">@s.Name</option> }
                </select>
            </div>
            <div>
                <label>Create-user template</label>
                <select @bind="asgCreateTpl">
                    <option value="">— none (technician chooses) —</option>
                    @foreach (var t in createTemplates) { <option value="@t.Id">@t.Name</option> }
                </select>
            </div>
            <div>
                <label>Modify-user template</label>
                <select @bind="asgModifyTpl">
                    <option value="">— none (technician chooses) —</option>
                    @foreach (var t in modifyTemplates) { <option value="@t.Id">@t.Name</option> }
                </select>
            </div>
        </div>
        <div class="hint" style="margin-top:6px">A selected template is enforced: the technician sees only that layout on Create/Modify (no template switcher). SID — из claims техника/группы. Домен-админы и супер-админы (@string.Join(", ", SuperNames)) имеют полный доступ без назначений.</div>
        <div class="btnrow"><button class="primary" @onclick="CreateAssignment" disabled="@(string.IsNullOrWhiteSpace(asgSid) || string.IsNullOrEmpty(asgRole) || string.IsNullOrEmpty(asgScope))">Create assignment</button></div>
    </div>
    }

    @* ---------- Help Desk Audit Reports ---------- *@
    @if (section == "audit-report")
    {
        <div class="panel">
            <h3>Audit Report</h3>
            <div class="hint">Management actions performed by help-desk technicians over AD. Times in MSK.</div>
            <div style="display:flex;gap:12px;align-items:flex-end;margin:10px 0;flex-wrap:wrap">
                <div><label>Technician</label>
                    <select @bind="repActor">
                        <option value="">All</option>
                        @foreach (var a in repActors) { <option value="@a.Sid">@a.Name</option> }
                    </select></div>
                <div><label>Period</label>
                    <select @bind="repPeriod">
                        <option value="1">Last 24 hours</option>
                        <option value="7">Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="0">All</option>
                    </select></div>
                <button class="primary" @onclick="() => LoadReport(AuditKind.AdOperation)">Go</button>
            </div>
            @if (repRows is null) { <p class="muted">Select filters and click Go.</p> }
            else if (repRows.Count == 0) { <p class="muted">No records.</p> }
            else
            {
                <table><thead><tr><th>Time (MSK)</th><th>Technician</th><th>Action</th><th>Target</th><th>Status</th><th>Message</th></tr></thead><tbody>
                @foreach (var e in repRows)
                {
                    <tr>
                        <td>@e.TimestampMsk.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@e.ActorName</td>
                        <td>@PermissionLabel(e.Operation)</td>
                        <td style="max-width:320px;word-break:break-all">@DnFormat.Friendly(e.TargetDn)</td>
                        <td><span class="badge @(e.Success ? "ok" : "off")">@(e.Success ? "success" : "fail")</span></td>
                        <td>@e.Message</td>
                    </tr>
                }
                </tbody></table>
                <p class="hint">@repRows.Count record(s)</p>
            }
        </div>
    }

    @if (section == "admin-audit")
    {
        <div class="panel">
            <h3>Admin Audit Report</h3>
            <div class="hint">Changes to panel configuration: roles, scopes, assignments, local accounts, settings.</div>
            <div style="display:flex;gap:12px;align-items:flex-end;margin:10px 0">
                <div><label>Period</label>
                    <select @bind="repPeriod">
                        <option value="1">Last 24 hours</option>
                        <option value="7">Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="0">All</option>
                    </select></div>
                <button class="primary" @onclick="() => LoadReport(AuditKind.ConfigChange)">Go</button>
            </div>
            @if (repRows is null) { <p class="muted">Select a period and click Go.</p> }
            else if (repRows.Count == 0) { <p class="muted">No records.</p> }
            else
            {
                <table><thead><tr><th>Time (MSK)</th><th>Managed By</th><th>Feature</th><th>Instance</th><th>Action</th></tr></thead><tbody>
                @foreach (var e in repRows)
                {
                    <tr>
                        <td>@e.TimestampMsk.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@e.ActorName</td>
                        <td>@e.Feature</td>
                        <td>@e.Instance</td>
                        <td>@e.Action</td>
                    </tr>
                }
                </tbody></table>
                <p class="hint">@repRows.Count record(s)</p>
            }
        </div>
    }

    @* ---------- Help Desk Reports ---------- *@
    @if (section == "technicians-report")
    {
        <div class="panel">
            <h3>Technicians Report</h3>
            <div class="hint">All subjects with delegated access: their roles, scopes and field limits.</div>
            @if (cfg.Assignments.Count == 0) { <p class="muted">No assignments yet.</p> }
            else
            {
                <table><thead><tr><th>Subject</th><th>Type</th><th>Role</th><th>Scope (OUs)</th><th>Templates</th></tr></thead><tbody>
                @foreach (var a in cfg.Assignments)
                {
                    var role = cfg.Roles.FirstOrDefault(r => r.Id == a.RoleId);
                    var scope = cfg.Scopes.FirstOrDefault(s => s.Id == a.ScopeId);
                    <tr>
                        <td><b>@(a.SubjectName ?? a.SubjectSid)</b></td>
                        <td>@a.SubjectType</td>
                        <td>@(role is null ? "—" : (role.IsSuperAdmin ? "Super admin" : role.Name))</td>
                        <td style="max-width:340px">@(scope is null ? "—" : $"{scope.Name} ({scope.OuDns.Count} OU)")</td>
                        <td>@(a.CreateTemplateId is null && a.ModifyTemplateId is null ? "—" : "enforced")</td>
                    </tr>
                }
                </tbody></table>
                <p class="hint">@cfg.Assignments.Count assignment(s). Domain admins and super-admins have full access without assignments.</p>
            }
        </div>
    }

    @if (section == "logon-report")
    {
        <div class="panel">
            <h3>Technician Logon Report</h3>
            <div class="hint">Logon history of panel users (local and domain). Times in MSK.</div>
            <div style="display:flex;gap:12px;align-items:flex-end;margin:10px 0">
                <div><label>Period</label>
                    <select @bind="repPeriod">
                        <option value="1">Today</option>
                        <option value="7">Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="0">All</option>
                    </select></div>
                <button class="primary" @onclick="() => LoadReport(AuditKind.Logon)">Go</button>
            </div>
            @if (repRows is null) { <p class="muted">Select a period and click Go.</p> }
            else if (repRows.Count == 0) { <p class="muted">No records.</p> }
            else
            {
                <table><thead><tr><th>Time (MSK)</th><th>Technician</th><th>Host</th><th>Method</th><th>Status</th><th>Message</th></tr></thead><tbody>
                @foreach (var e in repRows)
                {
                    <tr>
                        <td>@e.TimestampMsk.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@e.ActorName</td>
                        <td>@e.Host</td>
                        <td>@e.Method</td>
                        <td><span class="badge @(e.Success ? "ok" : "off")">@(e.Success ? "success" : "fail")</span></td>
                        <td>@e.Message</td>
                    </tr>
                }
                </tbody></table>
                <p class="hint">@repRows.Count record(s)</p>
            }
        </div>
    }
}
</RequireAccess>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private RbacConfig? cfg;
    private string? banner; private bool ok;

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }

    // --- отчёты (Audit / Admin Audit / Logon) ---
    private string repActor = "";
    private string repPeriod = "7";
    private List<AuditEntry>? repRows;
    private List<(string Sid, string Name)> repActors = new();

    private async Task LoadReport(AuditKind kind)
    {
        DateTimeOffset? from = null;
        if (int.TryParse(repPeriod, out var days) && days > 0)
            from = MskTime.Now.AddDays(-days);
        var actor = kind == AuditKind.AdOperation && !string.IsNullOrEmpty(repActor) ? repActor : null;
        repRows = (await Audit.QueryAsync(new AuditQuery(FromMsk: from, ActorSid: actor, Take: 500, Kind: kind))).ToList();
    }

    private static readonly string[] SuperNames = { "merl", "Domain Admins" };

    // Человекочитаемые подписи операций (enum-имена без пробелов не показываем).
    private static readonly Dictionary<Permission, string> PermLabels = new()
    {
        [Permission.ResetPassword] = "Reset password",
        [Permission.UnlockAccount] = "Unlock account",
        [Permission.EnableDisableUser] = "Enable / disable user",
        [Permission.CreateUser] = "Create user",
        [Permission.DeleteUser] = "Delete user",
        [Permission.ModifyAttributes] = "Modify users",
        [Permission.MoveObject] = "Move object",
        [Permission.ManageGroupMembership] = "Manage group membership",
        [Permission.Rename] = "Rename",
        [Permission.SetAccountOptions] = "Set account options",
        [Permission.CreateGroup] = "Create group",
        [Permission.CreateComputer] = "Create computer",
        [Permission.ManageComputer] = "Manage computer",
        [Permission.CreateOu] = "Create OU",
        [Permission.ManageOu] = "Manage OU",
        [Permission.CreateContact] = "Create contact",
        [Permission.ManageContact] = "Manage contact",
        [Permission.DeleteObject] = "Delete object",
        [Permission.EnableMailbox] = "Enable mailbox",
        [Permission.DisableMailbox] = "Disable mailbox",
        [Permission.SetMailboxProperties] = "Set mailbox properties",
        [Permission.ManageDistribution] = "Manage distribution groups",
        [Permission.ManageMailboxPermissions] = "Manage mailbox permissions",
        [Permission.ManageGpoLinks] = "Manage GPO links",
        [Permission.ViewReports] = "View reports",
        [Permission.ManageDelegation] = "Manage delegation",
        [Permission.ManageAutomation] = "Manage automation",
        [Permission.ManageSettings] = "Manage settings",
        [Permission.ManagePasswordExpiry] = "Manage password expiry",
    };

    private static string PermissionLabel(Permission p) => PermLabels.GetValueOrDefault(p, p.ToString());

    // Группировка операций по функционалу; внутри группы — по алфавиту подписи.
    private static readonly (string Group, Permission[] Perms)[] PermissionGroups = BuildGroups();

    private static (string, Permission[])[] BuildGroups()
    {
        var groups = new (string Group, Permission[] Perms)[]
        {
            ("Users", new[] { Permission.ResetPassword, Permission.UnlockAccount, Permission.EnableDisableUser,
                Permission.CreateUser, Permission.DeleteUser, Permission.ModifyAttributes, Permission.MoveObject,
                Permission.ManageGroupMembership, Permission.Rename, Permission.SetAccountOptions }),
            ("Groups", new[] { Permission.CreateGroup }),
            ("Computers", new[] { Permission.CreateComputer, Permission.ManageComputer }),
            ("Organizational Units", new[] { Permission.CreateOu, Permission.ManageOu }),
            ("Contacts", new[] { Permission.CreateContact, Permission.ManageContact }),
            ("Objects", new[] { Permission.DeleteObject }),
            ("Exchange", new[] { Permission.EnableMailbox, Permission.DisableMailbox, Permission.SetMailboxProperties,
                Permission.ManageDistribution, Permission.ManageMailboxPermissions }),
            ("Group Policy", new[] { Permission.ManageGpoLinks }),
            ("Administration", new[] { Permission.ViewReports, Permission.ManageDelegation,
                Permission.ManageAutomation, Permission.ManageSettings, Permission.ManagePasswordExpiry }),
        };
        return groups
            .Select(g => (g.Group, g.Perms.OrderBy(PermissionLabel, StringComparer.OrdinalIgnoreCase).ToArray()))
            .ToArray();
    }

    private string roleName = "";
    private bool roleIsSuper;
    private string permTab = "";   // активная вкладка группы прав (по имени группы)
    private readonly HashSet<Permission> rolePerms = new();
    private readonly HashSet<string> createFields = new();
    private readonly HashSet<string> modifyFields = new();

    private string scopeName = "";
    private readonly HashSet<string> scopeOus = new();

    private string asgType = "Technician", asgSid = "", asgRole = "", asgScope = "";
    private string asgCreateTpl = "", asgModifyTpl = "";
    private string subjSearch = "", asgName = "";
    private List<AdSearchResult>? subjResults;

    private List<UserTemplate> createTemplates = new();
    private List<UserTemplate> modifyTemplates = new();

    [SupplyParameterFromQuery(Name = "s")] private string? S { get; set; }
    private string section = "roles";

    private static readonly string[] KnownSections =
        { "roles", "scopes", "assignments", "audit-report", "admin-audit", "technicians-report", "logon-report" };

    protected override async Task OnInitializedAsync()
    {
        cfg = await Store.LoadAsync();
        var tpls = await Templates.ListAsync();
        createTemplates = tpls.Where(t => t.Kind == "Create").ToList();
        modifyTemplates = tpls.Where(t => t.Kind == "Modify").ToList();
        // техники для фильтра Audit Report (уникальные субъекты назначений)
        repActors = cfg.Assignments
            .Select(a => (Sid: a.SubjectSid, Name: a.SubjectName ?? a.SubjectSid))
            .DistinctBy(x => x.Sid).OrderBy(x => x.Name).ToList();
    }

    protected override void OnParametersSet()
        => section = KnownSections.Contains(S) ? S! : "roles";

    private string RoleName(Guid id) => cfg!.Roles.FirstOrDefault(r => r.Id == id)?.Name ?? "?";
    private string ScopeName(Guid id) => cfg!.Scopes.FirstOrDefault(s => s.Id == id)?.Name ?? "?";
    private string TemplateName(Guid id)
    {
        var all = createTemplates.Concat(modifyTemplates);
        return all.FirstOrDefault(t => t.Id == id)?.Name ?? "?";
    }

    private void TogglePerm(Permission p, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) rolePerms.Add(p); else rolePerms.Remove(p); }

    private async Task CreateRole()
    {
        cfg!.Roles.Add(new HelpDeskRole
        {
            Name = roleName.Trim(),
            IsSuperAdmin = roleIsSuper,
            Permissions = new HashSet<Permission>(rolePerms),
            CreateUserFields = rolePerms.Contains(Permission.CreateUser) ? new HashSet<string>(createFields) : new(),
            ModifyUserFields = rolePerms.Contains(Permission.ModifyAttributes) ? new HashSet<string>(modifyFields) : new(),
        });
        var name = roleName.Trim();
        await Save("Role created.");
        await ConfigAudit.WriteAsync(Audit, await Actor(), "Help Desk Role", name, "Created");
        roleName = ""; roleIsSuper = false; rolePerms.Clear(); createFields.Clear(); modifyFields.Clear();
    }
    private async Task DeleteRole(Guid id)
    {
        var role = cfg!.Roles.FirstOrDefault(r => r.Id == id);
        if (role is null) return;
        if (role.IsBuiltin) { ok = false; banner = "Built-in role cannot be deleted."; return; }
        if (cfg.Assignments.Any(a => a.RoleId == id)) { ok = false; banner = "Role is in use by assignments — remove them first."; return; }
        cfg.Roles.RemoveAll(r => r.Id == id); await Save("Role deleted.");
        await ConfigAudit.WriteAsync(Audit, await Actor(), "Help Desk Role", role.Name, "Deleted");
    }

    private async Task CreateScope()
    {
        // Каскад дерева уже перечислил всех выбранных потомков явно, поэтому
        // IncludeSubtree=false (список OuDns полон). Семантика "с детьми" — через выбор.
        var name = scopeName.Trim();
        cfg!.Scopes.Add(new DelegationScope { Name = name, OuDns = scopeOus.ToList(), IncludeSubtree = false });
        await Save("Scope created."); scopeName = ""; scopeOus.Clear();
        await ConfigAudit.WriteAsync(Audit, await Actor(), "Scope", name, "Created");
    }
    private async Task DeleteScope(Guid id)
    {
        var name = cfg!.Scopes.FirstOrDefault(s => s.Id == id)?.Name ?? id.ToString();
        cfg.Scopes.RemoveAll(s => s.Id == id); await Save("Scope deleted.");
        await ConfigAudit.WriteAsync(Audit, await Actor(), "Scope", name, "Deleted");
    }

    private async Task FindSubject()
    {
        subjResults = (await Dir.SearchAsync(Ui.BaseDn, subjSearch.Trim()))
            .Where(x => ((x.ObjectClass?.Contains("user", StringComparison.OrdinalIgnoreCase) ?? false)
                         || (x.ObjectClass?.Contains("group", StringComparison.OrdinalIgnoreCase) ?? false))
                        && !(x.ObjectClass?.Contains("computer", StringComparison.OrdinalIgnoreCase) ?? false))
            .Take(10).ToList();
    }

    private async Task PickSubject(AdSearchResult s)
    {
        var sid = await Dir.GetSidAsync(s.Dn);
        if (string.IsNullOrEmpty(sid)) { ok = false; banner = "Could not read SID for the selected object."; return; }
        asgSid = sid;
        asgName = s.Name;
        asgType = (s.ObjectClass?.Contains("group", StringComparison.OrdinalIgnoreCase) ?? false) ? "AdGroup" : "Technician";
        subjResults = null; subjSearch = "";
    }

    private void ClearSubject() { asgName = ""; asgSid = ""; subjResults = null; }

    private async Task CreateAssignment()
    {
        cfg!.Assignments.Add(new RoleAssignment
        {
            SubjectType = Enum.Parse<SubjectType>(asgType),
            SubjectSid = asgSid.Trim(),
            SubjectName = string.IsNullOrWhiteSpace(asgName) ? null : asgName,
            RoleId = Guid.Parse(asgRole),
            ScopeId = Guid.Parse(asgScope),
            CreateTemplateId = Guid.TryParse(asgCreateTpl, out var ctId) ? ctId : null,
            ModifyTemplateId = Guid.TryParse(asgModifyTpl, out var mtId) ? mtId : null,
        });
        var subj = string.IsNullOrWhiteSpace(asgName) ? asgSid : asgName;
        await Save("Assignment created.");
        await ConfigAudit.WriteAsync(Audit, await Actor(), "Assignment", subj, "Created");
        asgSid = ""; asgName = ""; asgRole = ""; asgScope = ""; asgCreateTpl = ""; asgModifyTpl = "";
    }
    private async Task DeleteAssignment(Guid id)
    {
        var a0 = cfg!.Assignments.FirstOrDefault(a => a.Id == id);
        var subj = a0?.SubjectName ?? a0?.SubjectSid ?? id.ToString();
        cfg.Assignments.RemoveAll(a => a.Id == id); await Save("Assignment deleted.");
        await ConfigAudit.WriteAsync(Audit, await Actor(), "Assignment", subj, "Deleted");
    }

    private async Task Save(string msg)
    {
        try { await Store.SaveAsync(cfg!); ok = true; banner = msg; }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; }
        cfg = await Store.LoadAsync();
    }

}
