@page "/computers/create"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject UiOptions Ui
@inject NavigationManager Nav

<PageTitle>Create computer — admanager</PageTitle>
<h1>Create computer</h1>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="panel" style="max-width:660px">
    <label>Target OU</label>
    <select @bind="ouDn">
        <option value="@Ui.BaseDn">(domain root)</option>
        @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
        {
            <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
        }
    </select>
    <div class="hint">The computer account is created in this OU.</div>

    <label>Name</label>
    <input type="text" @bind="newName" placeholder="WKS-01" />
    <div class="hint">sAMAccountName becomes NAME$.</div>

    <div class="btnrow" style="margin-top:16px">
        <button class="primary" @onclick="Create" disabled="@string.IsNullOrWhiteSpace(newName)">Create computer</button>
        <button @onclick='() => Nav.NavigateTo("computers")'>Back to computers</button>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<AdOuNode>? ous;
    private string ouDn = "";
    private string newName = "";
    private string? banner; private bool ok;

    protected override async Task OnInitializedAsync()
    {
        ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList();
        ouDn = ous.Any(o => o.Dn == Ui.RootOu) ? Ui.RootOu : Ui.BaseDn;
    }

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }

    private async Task Create()
    {
        var r = await Mgmt.CreateComputerAsync(await Actor(), new CreateComputerRequest(ouDn, newName.Trim()));
        ok = r.Success;
        banner = r.Success ? $"Computer '{newName}' created." : ("Error: " + r.Message);
        if (r.Success) newName = "";
    }

    private static string Indent(int d) => new string(' ', d * 3);
}
