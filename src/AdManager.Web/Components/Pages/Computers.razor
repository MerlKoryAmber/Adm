@page "/computers"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject UiOptions Ui
@inject NavigationManager Nav

<PageTitle>Computer Management — admanager</PageTitle>
<h1>Computer Management</h1>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="toolbar">
    <input class="searchbox" type="text" placeholder="Search name / OS…" @bind="search" @bind:event="oninput" @bind:after="() => page = 0" />
    <label class="chkinline"><input type="checkbox" @bind="onlyDisabled" @bind:after="() => page = 0" /> Disabled only</label>
    <label class="chkinline">
        OU:
        <select @bind="ouDn" @bind:after="Load" style="max-width:220px">
            <option value="@Ui.BaseDn">(domain root)</option>
            @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
            {
                <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
            }
        </select>
    </label>
    <span class="grow"></span>
    <button @onclick='() => Nav.NavigateTo("computers/create")'>+ Create</button>
    <button @onclick="Load">Refresh</button>
</div>

@if (selected.Count > 0)
{
    <div class="bulkbar">
        <span class="count">@selected.Count selected</span>
        <button @onclick="() => BulkEnabled(true)">Enable</button>
        <button @onclick="() => BulkEnabled(false)">Disable</button>
        <button @onclick="BulkReset">Reset account</button>
        <select @bind="bulkMoveTo" style="max-width:180px">
            <option value="">move to…</option>
            <option value="@Ui.BaseDn">(domain root)</option>
            @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
            {
                <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
            }
        </select>
        <button @onclick="BulkMove" disabled="@string.IsNullOrEmpty(bulkMoveTo)">Move</button>
        @if (!confirmBulkDelete) { <button class="danger" @onclick="() => confirmBulkDelete = true">Delete…</button> }
        else
        {
            <button class="danger" @onclick="BulkDelete">Confirm delete @selected.Count</button>
            <button @onclick="() => confirmBulkDelete = false">Cancel</button>
        }
        <button class="linkbtn" @onclick="ClearSel">clear</button>
    </div>
}

@if (items is null)
{
    <p>Loading…</p>
}
else
{
    var filtered = Filtered();
    var total = filtered.Count;
    var pages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
    if (page >= pages) page = pages - 1;
    var pageItems = filtered.Skip(page * PageSize).Take(PageSize).ToList();

    <div class="gridpanel">
        <div style="overflow-x:auto">
            <table>
                <thead>
                    <tr>
                        <th class="chk"><input type="checkbox" checked="@AllOnPageSelected(pageItems)" @onchange="e => TogglePage(pageItems, e)" /></th>
                        <th>Name</th><th>OS</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in pageItems)
                    {
                        <tr class="@(sel?.Dn == c.Dn ? "selected" : null)">
                            <td class="chk"><input type="checkbox" checked="@selected.Contains(c.Dn)" @onchange="e => ToggleOne(c.Dn, e)" /></td>
                            <td>@c.Name</td>
                            <td>@(c.OperatingSystem ?? "—")</td>
                            <td><span class="badge @(c.Enabled ? "ok" : "off")">@(c.Enabled ? "Enabled" : "Disabled")</span></td>
                            <td><button class="linkbtn" @onclick="() => Select(c)">Manage ▸</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="pager">
        <span>@total computer(s)</span>
        <button @onclick="() => page = 0" disabled="@(page == 0)">« First</button>
        <button @onclick="() => page--" disabled="@(page == 0)">‹ Prev</button>
        <span>Page @(page + 1) / @pages</span>
        <button @onclick="() => page++" disabled="@(page >= pages - 1)">Next ›</button>
        <button @onclick="() => page = pages - 1" disabled="@(page >= pages - 1)">Last »</button>
    </div>
}

<div class="panel" style="margin-top:16px">
        @if (sel is null) { <p class="muted">Select a computer (Manage ▸) to manage.</p> }
        else
        {
            <div class="panelhead"><h3>@sel.Name</h3><button class="linkbtn" @onclick="() => sel = null">close</button></div>
            <p class="hint">@sel.Dn</p>
            <div class="btnrow">
                @if (sel.Enabled) { <button @onclick="() => SetEnabled(false)">Disable</button> }
                else { <button class="primary" @onclick="() => SetEnabled(true)">Enable</button> }
                <button @onclick="ResetAccount">Reset account</button>
            </div>

            <h3 style="margin-top:12px">Attributes</h3>
            <label>Description</label><input type="text" @bind="cDesc" />
            <label>Location</label><input type="text" @bind="cLocation" />
            <label>Managed by (DN)</label><input type="text" @bind="cManagedBy" />
            <div class="btnrow"><button class="primary" @onclick="SaveAttrs">Save attributes</button></div>

            <hr />
            <label>Rename (new CN)</label>
            <input type="text" @bind="renameTo" />
            <div class="btnrow"><button @onclick="Rename" disabled="@string.IsNullOrWhiteSpace(renameTo)">Rename</button></div>

            <label>Move to OU</label>
            <select @bind="moveTo">
                <option value="@Ui.BaseDn">(domain root)</option>
                @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
                {
                    <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
                }
            </select>
            <div class="btnrow"><button @onclick="Move">Move</button></div>

            <hr />
            @if (!confirmDelete) { <button class="danger" @onclick="() => confirmDelete = true">Delete…</button> }
            else
            {
                <div class="banner err">Delete <b>@sel.Name</b>?</div>
                <div class="btnrow"><button class="danger" @onclick="Delete">Yes, delete</button><button @onclick="() => confirmDelete = false">Cancel</button></div>
            }
        }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const int PageSize = 50;
    private List<AdOuNode>? ous;
    private List<AdComputerSummary>? items;
    private AdComputerSummary? sel;
    private readonly HashSet<string> selected = new();
    private string search = "", ouDn = "";
    private bool onlyDisabled;
    private string renameTo = "", moveTo = "", bulkMoveTo = "";
    private string cDesc = "", cLocation = "", cManagedBy = "";
    private int page;
    private string? banner; private bool ok; private bool confirmDelete; private bool confirmBulkDelete;

    protected override async Task OnInitializedAsync()
    {
        ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList();
        ouDn = ous.Any(o => o.Dn == Ui.RootOu) ? Ui.RootOu : Ui.BaseDn;
        moveTo = ouDn;
        await Load();
    }

    private async Task Load()
    {
        try { items = (await Dir.ListComputersAsync(ouDn, subtree: true)).ToList(); sel = null; selected.Clear(); confirmBulkDelete = false; page = 0; }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; }
    }

    private List<AdComputerSummary> Filtered()
    {
        var q = items!.AsEnumerable();
        if (onlyDisabled) q = q.Where(c => !c.Enabled);
        if (!string.IsNullOrWhiteSpace(search))
        {
            var t = search.Trim();
            q = q.Where(c =>
                (c.Name?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.OperatingSystem?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return q.ToList();
    }

    private bool AllOnPageSelected(List<AdComputerSummary> pageItems) => pageItems.Count > 0 && pageItems.All(c => selected.Contains(c.Dn));
    private void TogglePage(List<AdComputerSummary> pageItems, ChangeEventArgs e)
    {
        var on = (bool)(e.Value ?? false);
        foreach (var c in pageItems) { if (on) selected.Add(c.Dn); else selected.Remove(c.Dn); }
    }
    private void ToggleOne(string dn, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) selected.Add(dn); else selected.Remove(dn); }
    private void ClearSel() { selected.Clear(); confirmBulkDelete = false; }

    private async Task BulkEnabled(bool en)
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Mgmt.SetEnabledAsync(actor, dn, en); if (r.Success) okc++; else fail++; }
        Finish(en ? "Enable" : "Disable", okc, fail);
    }

    private async Task BulkReset()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Mgmt.ResetComputerAccountAsync(actor, dn); if (r.Success) okc++; else fail++; }
        Finish("Reset account", okc, fail);
    }

    private async Task BulkMove()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Mgmt.MoveAsync(actor, dn, bulkMoveTo); if (r.Success) okc++; else fail++; }
        bulkMoveTo = ""; Finish("Move", okc, fail);
    }

    private async Task BulkDelete()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Mgmt.DeleteObjectAsync(actor, dn); if (r.Success) okc++; else fail++; }
        Finish("Delete", okc, fail);
    }

    private async Task Finish(string op, int okc, int fail)
    {
        ok = fail == 0; banner = $"{op}: {okc} ok, {fail} failed.";
        selected.Clear(); confirmBulkDelete = false; await Load();
    }

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }

    private async Task Select(AdComputerSummary c)
    {
        sel = c; banner = null; confirmDelete = false; renameTo = ""; moveTo = ouDn;
        var det = await Dir.GetObjectAsync(c.Dn, new[] { "description", "location", "managedBy" });
        cDesc = det?.Attributes.GetValueOrDefault("description") ?? "";
        cLocation = det?.Attributes.GetValueOrDefault("location") ?? "";
        cManagedBy = det?.Attributes.GetValueOrDefault("managedBy") ?? "";
    }

    private async Task SaveAttrs()
    {
        var attrs = new Dictionary<string, string?> { ["description"] = cDesc, ["location"] = cLocation, ["managedBy"] = cManagedBy };
        Show(await Mgmt.SetAttributesAsync(await Actor(), sel!.Dn, attrs));
    }

    private async Task ResetAccount() { Show(await Mgmt.ResetComputerAccountAsync(await Actor(), sel!.Dn)); }

    private async Task SetEnabled(bool en) { Show(await Mgmt.SetEnabledAsync(await Actor(), sel!.Dn, en)); await Load(); }
    private async Task Rename() { Show(await Mgmt.RenameAsync(await Actor(), sel!.Dn, $"CN={renameTo}")); await Load(); }
    private async Task Move() { Show(await Mgmt.MoveAsync(await Actor(), sel!.Dn, moveTo)); await Load(); }
    private async Task Delete() { Show(await Mgmt.DeleteObjectAsync(await Actor(), sel!.Dn)); confirmDelete = false; sel = null; await Load(); }

    private void Show(OperationResult r) { ok = r.Success; banner = r.Success ? "Done." : ("Error: " + r.Message); }
    private static string Indent(int d) => new string(' ', d * 3);
}
