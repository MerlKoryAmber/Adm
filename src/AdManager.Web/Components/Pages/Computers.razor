@page "/computers"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject UiOptions Ui

<PageTitle>Computer Management — admanager</PageTitle>
<h1>Computer Management</h1>

<div class="panelhead" style="max-width:520px">
    <div style="flex:1">
        <label>Organizational Unit</label>
        <select @bind="ouDn" @bind:after="Load">
            <option value="@Ui.BaseDn">(domain root)</option>
            @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
            {
                <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
            }
        </select>
    </div>
</div>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="layout2">
    <div class="panel">
        <div class="panelhead"><h3>Computers</h3><button @onclick="Load">Refresh</button></div>
        @if (items is null) { <p>Loading…</p> }
        else
        {
            <table>
                <thead><tr><th>Name</th><th>OS</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var c in items)
                    {
                        <tr class="selectable @(sel?.Dn == c.Dn ? "selected" : null)" @onclick="() => Select(c)">
                            <td>@c.Name</td><td>@(c.OperatingSystem ?? "—")</td>
                            <td><span class="badge @(c.Enabled ? "ok" : "off")">@(c.Enabled ? "Enabled" : "Disabled")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="hint">@items.Count computer(s)</p>
        }

        <hr />
        <h3>Create computer</h3>
        <label>Name</label>
        <input type="text" @bind="newName" placeholder="WKS-01" />
        <div class="hint">Created in the selected OU. sAMAccountName becomes NAME$.</div>
        <div class="btnrow"><button class="primary" @onclick="Create" disabled="@string.IsNullOrWhiteSpace(newName)">Create</button></div>
    </div>

    <div class="panel">
        @if (sel is null) { <p class="muted">Select a computer to manage.</p> }
        else
        {
            <h3>@sel.Name</h3>
            <p class="hint">@sel.Dn</p>
            <div class="btnrow">
                @if (sel.Enabled) { <button @onclick="() => SetEnabled(false)">Disable</button> }
                else { <button class="primary" @onclick="() => SetEnabled(true)">Enable</button> }
            </div>

            <label>Rename (new CN)</label>
            <input type="text" @bind="renameTo" />
            <div class="btnrow"><button @onclick="Rename" disabled="@string.IsNullOrWhiteSpace(renameTo)">Rename</button></div>

            <label>Move to OU</label>
            <select @bind="moveTo">
                <option value="@Ui.BaseDn">(domain root)</option>
                @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
                {
                    <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
                }
            </select>
            <div class="btnrow"><button @onclick="Move">Move</button></div>

            <hr />
            @if (!confirmDelete) { <button class="danger" @onclick="() => confirmDelete = true">Delete…</button> }
            else
            {
                <div class="banner err">Delete <b>@sel.Name</b>?</div>
                <div class="btnrow"><button class="danger" @onclick="Delete">Yes, delete</button><button @onclick="() => confirmDelete = false">Cancel</button></div>
            }
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<AdOuNode>? ous;
    private List<AdComputerSummary>? items;
    private AdComputerSummary? sel;
    private string ouDn = "";
    private string newName = "", renameTo = "", moveTo = "";
    private string? banner; private bool ok; private bool confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList();
        ouDn = ous.Any(o => o.Dn == Ui.RootOu) ? Ui.RootOu : Ui.BaseDn;
        moveTo = ouDn;
        await Load();
    }

    private async Task Load()
    {
        try { items = (await Dir.ListComputersAsync(ouDn, subtree: true)).ToList(); sel = null; }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; }
    }

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }

    private void Select(AdComputerSummary c) { sel = c; banner = null; confirmDelete = false; renameTo = ""; moveTo = ouDn; }

    private async Task SetEnabled(bool en) { Show(await Mgmt.SetEnabledAsync(await Actor(), sel!.Dn, en)); await Load(); }
    private async Task Rename() { Show(await Mgmt.RenameAsync(await Actor(), sel!.Dn, $"CN={renameTo}")); await Load(); }
    private async Task Move() { Show(await Mgmt.MoveAsync(await Actor(), sel!.Dn, moveTo)); await Load(); }
    private async Task Delete() { Show(await Mgmt.DeleteObjectAsync(await Actor(), sel!.Dn)); confirmDelete = false; sel = null; await Load(); }
    private async Task Create()
    {
        Show(await Mgmt.CreateComputerAsync(await Actor(), new CreateComputerRequest(ouDn, newName.Trim())));
        newName = ""; await Load();
    }

    private void Show(OperationResult r) { ok = r.Success; banner = r.Success ? "Done." : ("Error: " + r.Message); }
    private static string Indent(int d) => new string(' ', d * 3);
}
