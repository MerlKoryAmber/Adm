@page "/reports"
@using Microsoft.JSInterop
@inject IReportService ReportSvc
@inject UiOptions Ui
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Reports — admanager</PageTitle>
<h1>Reports</h1>
<RequireAccess Permissions="new[] { Permission.ViewReports }">
<p class="hint">Prebuilt read-only reports over the <b>@Ui.Domain</b> domain. Select a report, filter, and export to CSV.</p>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<section>
    <div class="toolbar">
        <strong>@current.Title</strong>
        <span class="grow"></span>
        <input class="searchbox" type="text" placeholder="Filter…" @bind="search" @bind:event="oninput" @bind:after="() => page = 0" />
        <button @onclick="Load">Refresh</button>
        <button @onclick="ExportCsv" disabled="@(result is null)">Export CSV</button>
    </div>
    <p class="hint">@current.Hint</p>

    @if (loading)
    {
        <p>Running report…</p>
    }
    else if (result is null)
    {
        <p class="muted">No data.</p>
    }
    else
    {
        var filtered = Filter(result.Rows);
        var total = filtered.Count;
        var pages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        if (page >= pages) page = pages - 1;
        var pageItems = filtered.Skip(page * PageSize).Take(PageSize).ToList();

        <div class="gridpanel">
            <div style="overflow-x:auto">
                <table>
                    <thead>
                        <tr>
                            @foreach (var c in result.Columns) { <th>@c</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in pageItems)
                        {
                            <tr>
                                @foreach (var cell in row.Cells) { <td>@(string.IsNullOrEmpty(cell) ? "—" : cell)</td> }
                            </tr>
                        }
                        @if (pageItems.Count == 0)
                        {
                            <tr><td colspan="@result.Columns.Count" class="muted">No objects match this report.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pager">
            <span>@total object(s)</span>
            <button @onclick="() => page = 0" disabled="@(page == 0)">« First</button>
            <button @onclick="() => page--" disabled="@(page == 0)">‹ Prev</button>
            <span>Page @(page + 1) / @pages</span>
            <button @onclick="() => page++" disabled="@(page >= pages - 1)">Next ›</button>
            <button @onclick="() => page = pages - 1" disabled="@(page >= pages - 1)">Last »</button>
        </div>
    }
</section>
</RequireAccess>

@code {
    private const int PageSize = 50;

    private ReportResult? result;
    private ReportDef current = default!;
    private string search = "";
    private int page;
    private bool loading;
    private string? banner; private bool ok;
    private IJSObjectReference? module;

    [SupplyParameterFromQuery(Name = "r")] private string? R { get; set; }

    protected override void OnInitialized()
        => current = ReportSvc.Find(R ?? "") ?? ReportSvc.Catalog[0];

    protected override async Task OnParametersSetAsync()
    {
        var def = ReportSvc.Find(R ?? "") ?? ReportSvc.Catalog[0];
        if (result is null || def.Key != current.Key)
        {
            current = def; page = 0; search = "";
            await Load();
        }
    }

    private async Task Load()
    {
        loading = true; banner = null; result = null; StateHasChanged();
        try { result = await ReportSvc.RunAsync(current.Key); }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; }
        finally { loading = false; }
    }

    private List<ReportRow> Filter(IReadOnlyList<ReportRow> src)
    {
        if (string.IsNullOrWhiteSpace(search)) return src.ToList();
        var t = search.Trim();
        return src.Where(r => r.Cells.Any(c => c.Contains(t, StringComparison.OrdinalIgnoreCase))).ToList();
    }


    private async Task ExportCsv()
    {
        if (result is null) return;
        var rows = Filter(result.Rows);
        var sb = new System.Text.StringBuilder();
        sb.Append(string.Join(",", result.Columns.Select(Csv))).Append("\r\n");
        foreach (var r in rows)
            sb.Append(string.Join(",", r.Cells.Select(Csv))).Append("\r\n");
        var name = $"report-{current.Key}-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Reports.razor.js");
        await module.InvokeVoidAsync("downloadCsv", name, sb.ToString());
    }

    private static string Csv(string? value)
    {
        var s = value ?? "";
        if (s.IndexOfAny(new[] { ',', '"', '\n', '\r' }) < 0) return s;
        return "\"" + s.Replace("\"", "\"\"") + "\"";
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch { }
        }
    }
}
