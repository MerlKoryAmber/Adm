@page "/users"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject UiOptions Ui
@inject NavigationManager Nav

<PageTitle>Users — admanager</PageTitle>
<h1>Users</h1>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="toolbar">
    <input class="searchbox" type="text" placeholder="Search name / account / email…" @bind="search" @bind:event="oninput" @bind:after="() => page = 0" />
    <label class="chkinline"><input type="checkbox" @bind="onlyLocked" @bind:after="() => page = 0" /> Locked only</label>
    <label class="chkinline"><input type="checkbox" @bind="onlyDisabled" @bind:after="() => page = 0" /> Disabled only</label>
    <span class="grow"></span>
    <button @onclick='() => Nav.NavigateTo("users/create")'>+ Create</button>
    <button @onclick='() => Nav.NavigateTo("users/bulk")'>Bulk CSV</button>
    <button @onclick="Load">Refresh</button>
</div>

@if (selected.Count > 0)
{
    <div class="bulkbar">
        <span class="count">@selected.Count selected</span>
        <button @onclick="() => Bulk(BulkOp.Enable)">Enable</button>
        <button @onclick="() => Bulk(BulkOp.Disable)">Disable</button>
        <button @onclick="() => Bulk(BulkOp.Unlock)">Unlock</button>
        <input type="password" placeholder="new password" @bind="bulkPwd" style="max-width:150px" />
        <button @onclick="BulkReset" disabled="@string.IsNullOrEmpty(bulkPwd)">Reset pwd</button>
        <select @bind="bulkMoveTo" style="max-width:180px">
            <option value="">move to…</option>
            @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
            {
                <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
            }
        </select>
        <button @onclick="BulkMove" disabled="@string.IsNullOrEmpty(bulkMoveTo)">Move</button>
        @if (!confirmBulkDelete) { <button class="danger" @onclick="() => confirmBulkDelete = true">Delete…</button> }
        else
        {
            <button class="danger" @onclick="() => Bulk(BulkOp.Delete)">Confirm delete @selected.Count</button>
            <button @onclick="() => confirmBulkDelete = false">Cancel</button>
        }
        <button class="linkbtn" @onclick="ClearSel">clear</button>
    </div>
}

@if (users is null)
{
    <p>Loading…</p>
}
else
{
    var filtered = Filtered();
    var total = filtered.Count;
    var pages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
    if (page >= pages) page = pages - 1;
    var pageItems = filtered.Skip(page * PageSize).Take(PageSize).ToList();

    <div class="gridpanel">
        <div style="overflow-x:auto">
            <table>
                <thead>
                    <tr>
                        <th class="chk"><input type="checkbox" checked="@AllOnPageSelected(pageItems)" @onchange="e => TogglePage(pageItems, e)" /></th>
                        <th>Display name</th><th>Account</th><th>Email</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in pageItems)
                    {
                        <tr>
                            <td class="chk"><input type="checkbox" checked="@selected.Contains(u.Dn)" @onchange="e => ToggleOne(u.Dn, e)" /></td>
                            <td>@u.DisplayName</td>
                            <td>@u.SamAccountName</td>
                            <td>@(u.Mail ?? u.Upn ?? "—")</td>
                            <td>
                                <span class="badge @(u.Enabled ? "ok" : "off")">@(u.Enabled ? "Enabled" : "Disabled")</span>
                                @if (u.LockedOut) { <span class="badge warn">Locked</span> }
                            </td>
                            <td><button class="linkbtn" @onclick="() => Modify(u)">Modify ▸</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="pager">
        <span>@total user(s)</span>
        <button @onclick="() => page = 0" disabled="@(page == 0)">« First</button>
        <button @onclick="() => page--" disabled="@(page == 0)">‹ Prev</button>
        <span>Page @(page + 1) / @pages</span>
        <button @onclick="() => page++" disabled="@(page >= pages - 1)">Next ›</button>
        <button @onclick="() => page = pages - 1" disabled="@(page >= pages - 1)">Last »</button>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const int PageSize = 50;
    private List<AdOuNode>? ous;
    private List<AdUserSummary>? users;
    private readonly HashSet<string> selected = new();
    private string search = "", bulkPwd = "", bulkMoveTo = "";
    private bool onlyLocked, onlyDisabled;
    private int page;
    private string? banner; private bool ok; private bool confirmBulkDelete;

    private enum BulkOp { Enable, Disable, Unlock, Delete }

    protected override async Task OnInitializedAsync()
    {
        ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList(); // для bulk «move to…»
        await Load();
    }

    private async Task Load()
    {
        try { users = (await Dir.ListUsersAsync(Ui.BaseDn, subtree: true)).ToList(); page = 0; }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; }
    }

    private List<AdUserSummary> Filtered()
    {
        var q = users!.AsEnumerable();
        if (onlyLocked) q = q.Where(u => u.LockedOut);
        if (onlyDisabled) q = q.Where(u => !u.Enabled);
        if (!string.IsNullOrWhiteSpace(search))
        {
            var t = search.Trim();
            q = q.Where(u =>
                (u.DisplayName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.SamAccountName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Upn?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.Mail?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return q.ToList();
    }

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }

    private void Modify(AdUserSummary u) => Nav.NavigateTo($"users/modify?dn={Uri.EscapeDataString(u.Dn)}");

    private bool AllOnPageSelected(List<AdUserSummary> pageItems) => pageItems.Count > 0 && pageItems.All(u => selected.Contains(u.Dn));
    private void TogglePage(List<AdUserSummary> pageItems, ChangeEventArgs e)
    {
        var on = (bool)(e.Value ?? false);
        foreach (var u in pageItems) { if (on) selected.Add(u.Dn); else selected.Remove(u.Dn); }
    }
    private void ToggleOne(string dn, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) selected.Add(dn); else selected.Remove(dn); }
    private void ClearSel() { selected.Clear(); confirmBulkDelete = false; }

    private async Task Bulk(BulkOp op)
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList())
        {
            var r = await (op switch
            {
                BulkOp.Enable => Mgmt.SetEnabledAsync(actor, dn, true),
                BulkOp.Disable => Mgmt.SetEnabledAsync(actor, dn, false),
                BulkOp.Unlock => Mgmt.UnlockAsync(actor, dn),
                BulkOp.Delete => Mgmt.DeleteAsync(actor, dn),
                _ => Task.FromResult(OperationResult.Fail("?")),
            });
            if (r.Success) okc++; else fail++;
        }
        Done(op.ToString(), okc, fail);
    }

    private async Task BulkReset()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Mgmt.ResetPasswordAsync(actor, dn, bulkPwd, false); if (r.Success) okc++; else fail++; }
        bulkPwd = ""; Done("Reset password", okc, fail);
    }

    private async Task BulkMove()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Mgmt.MoveAsync(actor, dn, bulkMoveTo); if (r.Success) okc++; else fail++; }
        bulkMoveTo = ""; Done("Move", okc, fail);
    }

    private async Task Done(string op, int okc, int fail)
    {
        ok = fail == 0; banner = $"{op}: {okc} ok, {fail} failed.";
        selected.Clear(); confirmBulkDelete = false;
        await Load();
    }

    private static string Indent(int d) => new string(' ', d * 3);
}
