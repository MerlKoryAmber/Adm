@page "/users"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject UiOptions Ui

<PageTitle>User Management — admanager</PageTitle>
<h1>User Management</h1>

<div style="max-width:520px">
    <label>Organizational Unit</label>
    <select @bind="ouDn" @bind:after="Load">
        <option value="@Ui.BaseDn">(domain root)</option>
        @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
        {
            <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
        }
    </select>
</div>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

@if (selected.Count > 0)
{
    <div class="bulkbar">
        <span class="count">@selected.Count selected</span>
        <button @onclick="() => Bulk(BulkOp.Enable)">Enable</button>
        <button @onclick="() => Bulk(BulkOp.Disable)">Disable</button>
        <button @onclick="() => Bulk(BulkOp.Unlock)">Unlock</button>
        <select @bind="bulkMoveTo" style="width:auto">
            <option value="">— move to OU —</option>
            @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
            {
                <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
            }
        </select>
        <button @onclick="BulkMove" disabled="@string.IsNullOrEmpty(bulkMoveTo)">Move</button>
        @if (!confirmBulkDelete) { <button class="danger" @onclick="() => confirmBulkDelete = true">Delete…</button> }
        else
        {
            <span class="muted">Delete @selected.Count?</span>
            <button class="danger" @onclick="() => Bulk(BulkOp.Delete)">Yes</button>
            <button @onclick="() => confirmBulkDelete = false">Cancel</button>
        }
        <button @onclick="ClearSel">Clear</button>
    </div>
}

<div class="layout2">
    <div class="panel">
        <div class="panelhead"><h3>Users</h3><button @onclick="Load">Refresh</button></div>
        @if (users is null) { <p>Loading…</p> }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th class="chk"><input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" /></th>
                        <th>Display name</th><th>Account</th><th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in users)
                    {
                        <tr class="selectable @(sel?.Dn == u.Dn ? "selected" : null)" @onclick="() => Select(u)">
                            <td class="chk" @onclick:stopPropagation="true">
                                <input type="checkbox" checked="@selected.Contains(u.Dn)" @onchange="e => ToggleOne(u.Dn, e)" />
                            </td>
                            <td>@u.DisplayName</td>
                            <td>@u.SamAccountName</td>
                            <td>
                                <span class="badge @(u.Enabled ? "ok" : "off")">@(u.Enabled ? "Enabled" : "Disabled")</span>
                                @if (u.LockedOut) { <span class="badge warn">Locked</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="hint">@users.Count user(s)</p>
        }
    </div>

    <div class="panel">
        @if (sel is null) { <p class="muted">Select a user to manage, or use checkboxes for bulk actions.</p> }
        else
        {
            <h3>@sel.DisplayName</h3>
            <p class="hint">@sel.Dn</p>

            <div class="btnrow">
                @if (sel.Enabled) { <button @onclick="() => Single(BulkOp.Disable)">Disable</button> }
                else { <button class="primary" @onclick="() => Single(BulkOp.Enable)">Enable</button> }
                <button @onclick="() => Single(BulkOp.Unlock)" disabled="@(!sel.LockedOut)">Unlock</button>
            </div>

            <label>New password</label>
            <input type="password" @bind="newPwd" placeholder="Enter a new password" />
            <div class="checkbox"><input type="checkbox" id="mc" @bind="mustChange" /><label for="mc">Must change at next logon</label></div>
            <div class="btnrow"><button class="primary" @onclick="ResetPassword" disabled="@string.IsNullOrEmpty(newPwd)">Reset password</button></div>

            <hr />
            <h3>Account options</h3>
            <div class="checkbox"><input type="checkbox" id="pne" checked="@pne" @onchange="TogglePne" /><label for="pne">Password never expires</label></div>
            <div class="btnrow"><button @onclick="ForceChange">Force change at next logon</button></div>
            <label>Account expires</label>
            <input type="date" @bind="expiry" />
            <div class="btnrow">
                <button @onclick="SetExpiry" disabled="@(expiry is null)">Set expiry</button>
                <button @onclick="ClearExpiry">Clear (never)</button>
            </div>

            <hr />
            <h3>Attributes</h3>
            <label>Display name</label><input type="text" @bind="attrDisplay" />
            <label>Email</label><input type="text" @bind="attrMail" />
            <label>Department</label><input type="text" @bind="attrDept" />
            <label>Title</label><input type="text" @bind="attrTitle" />
            <div class="btnrow"><button class="primary" @onclick="SaveAttributes">Save attributes</button></div>

            <hr />
            <h3>Rename / Move</h3>
            <label>Rename (new CN)</label><input type="text" @bind="renameTo" />
            <div class="btnrow"><button @onclick="Rename" disabled="@string.IsNullOrWhiteSpace(renameTo)">Rename</button></div>
            <label>Move to OU</label>
            <select @bind="moveTo">
                <option value="@Ui.BaseDn">(domain root)</option>
                @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
                {
                    <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
                }
            </select>
            <div class="btnrow"><button @onclick="Move">Move</button></div>

            <hr />
            <h3>Danger zone</h3>
            @if (!confirmDelete) { <button class="danger" @onclick="() => confirmDelete = true">Delete user…</button> }
            else
            {
                <div class="banner err">Delete <b>@sel.SamAccountName</b> permanently?</div>
                <div class="btnrow"><button class="danger" @onclick="DeleteSingle">Yes, delete</button><button @onclick="() => confirmDelete = false">Cancel</button></div>
            }
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<AdOuNode>? ous;
    private List<AdUserSummary>? users;
    private AdUserSummary? sel;
    private readonly HashSet<string> selected = new();
    private string ouDn = "";
    private string? banner; private bool ok;

    private string newPwd = ""; private bool mustChange;
    private string attrDisplay = "", attrMail = "", attrDept = "", attrTitle = "";
    private string renameTo = "", moveTo = "", bulkMoveTo = "";
    private bool pne; private DateTime? expiry;
    private bool confirmDelete, confirmBulkDelete;

    private enum BulkOp { Enable, Disable, Unlock, Delete }

    protected override async Task OnInitializedAsync()
    {
        ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList();
        ouDn = ous.Any(o => o.Dn == Ui.UsersOu) ? Ui.UsersOu : (ous.Any(o => o.Dn == Ui.RootOu) ? Ui.RootOu : Ui.BaseDn);
        await Load();
    }

    private async Task Load()
    {
        try { users = (await Dir.ListUsersAsync(ouDn, subtree: true)).ToList(); }
        catch (Exception ex) { Fail(ex.Message); }
    }

    private async Task<TechnicianContext> Actor()
    {
        var principal = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(principal);
    }

    private bool AllSelected => users is { Count: > 0 } && users.All(u => selected.Contains(u.Dn));
    private void ToggleAll(ChangeEventArgs e)
    {
        selected.Clear();
        if ((bool)(e.Value ?? false) && users is not null)
            foreach (var u in users) selected.Add(u.Dn);
    }
    private void ToggleOne(string dn, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) selected.Add(dn); else selected.Remove(dn); }
    private void ClearSel() { selected.Clear(); confirmBulkDelete = false; }

    private async Task Select(AdUserSummary u)
    {
        sel = u; banner = null; confirmDelete = false; newPwd = ""; mustChange = false; renameTo = ""; moveTo = ouDn; expiry = null;
        var det = await Dir.GetObjectAsync(u.Dn, new[] { "displayName", "mail", "department", "title", "userAccountControl" });
        attrDisplay = det?.Attributes.GetValueOrDefault("displayName") ?? u.DisplayName;
        attrMail = det?.Attributes.GetValueOrDefault("mail") ?? "";
        attrDept = det?.Attributes.GetValueOrDefault("department") ?? "";
        attrTitle = det?.Attributes.GetValueOrDefault("title") ?? "";
        var uac = int.TryParse(det?.Attributes.GetValueOrDefault("userAccountControl"), out var v) ? v : 0;
        pne = (uac & 0x10000) != 0;
    }

    private async Task ResetPassword() { Show(await Mgmt.ResetPasswordAsync(await Actor(), sel!.Dn, newPwd, mustChange)); newPwd = ""; }

    private async Task TogglePne(ChangeEventArgs e)
    {
        pne = (bool)(e.Value ?? false);
        Show(await Mgmt.SetAccountOptionsAsync(await Actor(), sel!.Dn, new AccountOptions(PasswordNeverExpires: pne)));
    }
    private async Task ForceChange() => Show(await Mgmt.SetAccountOptionsAsync(await Actor(), sel!.Dn, new AccountOptions(MustChangePasswordAtNextLogon: true)));
    private async Task SetExpiry() => Show(await Mgmt.SetAccountOptionsAsync(await Actor(), sel!.Dn, new AccountOptions(AccountExpiresUtc: expiry)));
    private async Task ClearExpiry() { expiry = null; Show(await Mgmt.SetAccountOptionsAsync(await Actor(), sel!.Dn, new AccountOptions(ClearAccountExpiry: true))); }

    private async Task SaveAttributes()
    {
        var attrs = new Dictionary<string, string?> { ["displayName"] = attrDisplay, ["mail"] = attrMail, ["department"] = attrDept, ["title"] = attrTitle };
        Show(await Mgmt.SetAttributesAsync(await Actor(), sel!.Dn, attrs));
        await Load(); ReSelect();
    }

    private async Task Rename() { Show(await Mgmt.RenameAsync(await Actor(), sel!.Dn, $"CN={renameTo}")); await Load(); sel = null; }
    private async Task Move() { Show(await Mgmt.MoveAsync(await Actor(), sel!.Dn, moveTo)); await Load(); sel = null; }

    private async Task Single(BulkOp op) { Show(await Apply(await Actor(), op, sel!.Dn)); await Load(); ReSelect(); }
    private async Task DeleteSingle() { Show(await Mgmt.DeleteAsync(await Actor(), sel!.Dn)); confirmDelete = false; sel = null; await Load(); }

    private async Task Bulk(BulkOp op)
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Apply(actor, op, dn); if (r.Success) okc++; else fail++; }
        ok = fail == 0; banner = $"{op}: {okc} ok, {fail} failed."; selected.Clear(); confirmBulkDelete = false; sel = null; await Load();
    }

    private async Task BulkMove()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Mgmt.MoveAsync(actor, dn, bulkMoveTo); if (r.Success) okc++; else fail++; }
        ok = fail == 0; banner = $"Move: {okc} ok, {fail} failed."; selected.Clear(); bulkMoveTo = ""; sel = null; await Load();
    }

    private Task<OperationResult> Apply(TechnicianContext actor, BulkOp op, string dn) => op switch
    {
        BulkOp.Enable => Mgmt.SetEnabledAsync(actor, dn, true),
        BulkOp.Disable => Mgmt.SetEnabledAsync(actor, dn, false),
        BulkOp.Unlock => Mgmt.UnlockAsync(actor, dn),
        BulkOp.Delete => Mgmt.DeleteAsync(actor, dn),
        _ => Task.FromResult(OperationResult.Fail("unknown op")),
    };

    private void ReSelect() => sel = users?.FirstOrDefault(x => x.SamAccountName == sel?.SamAccountName);
    private void Show(OperationResult r) { ok = r.Success; banner = r.Success ? "Done." : ("Error: " + r.Message); }
    private void Fail(string m) { ok = false; banner = "Error: " + m; }
    private static string Indent(int d) => new string(' ', d * 3);
}
