@page "/ous"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject UiOptions Ui
@inject NavigationManager Nav

<PageTitle>Modify OUs — admanager</PageTitle>
<h1>Modify OUs</h1>
<RequireAccess Permissions="new[] { Permission.CreateOu, Permission.ManageOu }">
<p class="subtitle">Organizational units under the managed domain.</p>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="layout2">
    <div class="panel">
        <div class="panelhead"><h3>Organizational Units</h3><span class="grow"></span><button @onclick='() => Nav.NavigateTo("ous/create")'>+ Create</button><button @onclick="Reload">Refresh</button></div>
        <OuTree @key="treeKey" Selectable="false" SelectedDn="@sel?.Dn" OnSelect="SelectOu" />
    </div>

    <div class="panel">
        @if (sel is null) { <p class="muted">Select an OU to manage.</p> }
        else
        {
            <h3>@sel.Name</h3>

            <label>Rename (new OU name)</label>
            <input type="text" @bind="renameTo" />
            <div class="btnrow"><button @onclick="Rename" disabled="@string.IsNullOrWhiteSpace(renameTo)">Rename</button></div>

            <label>Move under</label>
            <OuPicker Value="@moveTo" ValueChanged="v => moveTo = v" />
            <div class="btnrow"><button @onclick="Move">Move</button></div>

            <hr />
            @if (!confirmDelete) { <button class="danger" @onclick="() => confirmDelete = true">Delete…</button> }
            else
            {
                <div class="banner err">Delete <b>@sel.Name</b> and everything under it?</div>
                <div class="btnrow"><button class="danger" @onclick="Delete">Yes, delete</button><button @onclick="() => confirmDelete = false">Cancel</button></div>
            }
        }
    </div>
</div>
</RequireAccess>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // ous — плоский список только для селекта «Move under» (в <select> ленивое дерево не вставить).
    private List<AdOuNode>? ous;
    private AdOuNode? sel;
    private string renameTo = "", moveTo = "";
    private string? banner; private bool ok; private bool confirmDelete;
    private int treeKey;   // смена -> пересоздать OuTree (Refresh/после операции)

    protected override async Task OnInitializedAsync() { await Load(); }

    private async Task Load()
    {
        try { ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList(); }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; }
    }

    private async Task Reload() { sel = null; treeKey++; await Load(); }

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }

    private void SelectOu(AdOuNode o) { sel = o; banner = null; confirmDelete = false; renameTo = ""; moveTo = Ui.BaseDn; }

    private async Task Rename() { Show(await Mgmt.RenameAsync(await Actor(), sel!.Dn, $"OU={renameTo}")); await Reload(); }
    private async Task Move() { Show(await Mgmt.MoveAsync(await Actor(), sel!.Dn, moveTo)); await Reload(); }
    private async Task Delete() { Show(await Mgmt.DeleteObjectAsync(await Actor(), sel!.Dn)); confirmDelete = false; sel = null; await Reload(); }

    private void Show(OperationResult r) { ok = r.Success; banner = r.Success ? "Done." : ("Error: " + r.Message); }
    // Отступ для <option> (в select CSS не работает): неразрывные пробелы не схлопываются.
    private static string Indent(int d) => string.Concat(Enumerable.Repeat(' ', d * 3)) + (d > 0 ? "└ " : "");
}
