@page "/exchange"
@inject ExchangeManagementService Ex
@inject IAdDirectory Dir
@inject UiOptions Ui

<PageTitle>Exchange — admanager</PageTitle>
<h1>Exchange</h1>
<p class="subtitle">On-prem Exchange 2019 via remote PowerShell. Requires a configured Exchange server (Exchange:ConnectionUri).</p>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

<div class="toolbar">
    <input class="searchbox" type="text" placeholder="Search name / account…" @bind="search" @bind:event="oninput" @bind:after="() => page = 0" />
    <label class="chkinline">
        OU:
        <select @bind="ouDn" @bind:after="LoadUsers" style="max-width:220px">
            <option value="@Ui.BaseDn">(domain root)</option>
            @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
            {
                <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
            }
        </select>
    </label>
    <span class="grow"></span>
    <button @onclick="LoadUsers">Refresh</button>
</div>

@if (selected.Count > 0)
{
    <div class="bulkbar">
        <span class="count">@selected.Count selected</span>
        <button @onclick="BulkEnable">Enable mailbox</button>
        <button class="danger" @onclick="BulkDisable">Disable mailbox</button>
        <button class="linkbtn" @onclick="ClearSel">clear</button>
    </div>
}

@if (users is null)
{
    <p>Loading…</p>
}
else
{
    var filtered = Filtered();
    var total = filtered.Count;
    var pages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
    if (page >= pages) page = pages - 1;
    var pageItems = filtered.Skip(page * PageSize).Take(PageSize).ToList();

    <div class="gridpanel">
        <div style="overflow-x:auto">
            <table>
                <thead>
                    <tr>
                        <th class="chk"><input type="checkbox" checked="@AllOnPageSelected(pageItems)" @onchange="e => TogglePage(pageItems, e)" /></th>
                        <th>Display name</th><th>Account</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in pageItems)
                    {
                        <tr class="@(sel?.Dn == u.Dn ? "selected" : null)">
                            <td class="chk"><input type="checkbox" checked="@selected.Contains(u.Dn)" @onchange="e => ToggleOne(u.Dn, e)" /></td>
                            <td>@u.DisplayName</td>
                            <td>@u.SamAccountName</td>
                            <td><button class="linkbtn" @onclick="() => Select(u)">Mailbox ▸</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="pager">
        <span>@total user(s)</span>
        <button @onclick="() => page = 0" disabled="@(page == 0)">« First</button>
        <button @onclick="() => page--" disabled="@(page == 0)">‹ Prev</button>
        <span>Page @(page + 1) / @pages</span>
        <button @onclick="() => page++" disabled="@(page >= pages - 1)">Next ›</button>
        <button @onclick="() => page = pages - 1" disabled="@(page >= pages - 1)">Last »</button>
    </div>
}

<div class="layout2" style="margin-top:16px">
    <div class="panel">
        @if (sel is null) { <p class="muted">Select a user (Mailbox ▸) to manage its mailbox.</p> }
        else
        {
            <div class="panelhead"><h3>@sel.DisplayName</h3><button class="linkbtn" @onclick="() => sel = null">close</button></div>
            <p class="hint">@sel.Dn</p>
            <label>Alias (optional)</label>
            <input type="text" @bind="alias" placeholder="j.doe" />
            <div class="hint">Mailbox alias; leave empty to keep the default.</div>
            <div class="btnrow">
                <button class="primary" @onclick="EnableMailbox">Enable mailbox</button>
                <button class="danger" @onclick="DisableMailbox">Disable mailbox</button>
            </div>

            <label>Issue warning quota (MB)</label><input type="text" @bind="warnMb" />
            <label>Prohibit send quota (MB)</label><input type="text" @bind="sendMb" />
            <div class="checkbox"><input type="checkbox" id="hid" @bind="hidden" /><label for="hid">Hidden from address lists</label></div>
            <div class="btnrow"><button class="primary" @onclick="SetProps">Set properties</button></div>

            <hr />
            <h3>Permissions</h3>
            <div class="hint">Grant or revoke Full Access, Send As or Send on Behalf on this mailbox for another user.</div>
            <label>Trustee</label>
            <select @bind="trustee">
                <option value="">— select a user —</option>
                @foreach (var u in users ?? Enumerable.Empty<AdUserSummary>())
                {
                    <option value="@u.Dn">@u.DisplayName (@u.SamAccountName)</option>
                }
            </select>
            <div class="hint">The user who receives (or loses) the permission.</div>
            <div class="btnrow">
                <button @onclick="AddFullAccess" disabled="@NoTrustee">Add Full Access</button>
                <button class="danger" @onclick="RemoveFullAccess" disabled="@NoTrustee">Remove Full Access</button>
            </div>
            <div class="btnrow">
                <button @onclick="AddSendAs" disabled="@NoTrustee">Add Send As</button>
                <button class="danger" @onclick="RemoveSendAs" disabled="@NoTrustee">Remove Send As</button>
            </div>
            <div class="btnrow">
                <button @onclick="AddSendOnBehalf" disabled="@NoTrustee">Add Send on Behalf</button>
                <button class="danger" @onclick="RemoveSendOnBehalf" disabled="@NoTrustee">Remove Send on Behalf</button>
            </div>
        }
    </div>

    <div class="panel">
        <h3>Distribution groups</h3>
        <label>New group name</label><input type="text" @bind="dgName" placeholder="All-Sales" />
        <label>Target OU</label>
        <select @bind="dgOu">
            <option value="@Ui.BaseDn">(domain root)</option>
            @foreach (var o in ous ?? Enumerable.Empty<AdOuNode>())
            {
                <option value="@o.Dn">@Indent(o.Depth)@o.Name</option>
            }
        </select>
        <div class="btnrow"><button class="primary" @onclick="CreateDg" disabled="@string.IsNullOrWhiteSpace(dgName)">Create distribution group</button></div>

        <hr />
        <h3>Membership</h3>
        <label>Group identity</label><input type="text" @bind="dgIdentity" placeholder="All-Sales" />
        <label>Member</label>
        <select @bind="dgMember">
            <option value="">— select a user —</option>
            @foreach (var u in users ?? Enumerable.Empty<AdUserSummary>())
            {
                <option value="@u.Dn">@u.DisplayName (@u.SamAccountName)</option>
            }
        </select>
        <div class="btnrow">
            <button @onclick="AddMember" disabled="@(string.IsNullOrWhiteSpace(dgIdentity) || string.IsNullOrEmpty(dgMember))">Add member</button>
            <button class="danger" @onclick="RemoveMember" disabled="@(string.IsNullOrWhiteSpace(dgIdentity) || string.IsNullOrEmpty(dgMember))">Remove member</button>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const int PageSize = 50;
    private List<AdOuNode>? ous;
    private List<AdUserSummary>? users;
    private AdUserSummary? sel;
    private readonly HashSet<string> selected = new();
    private string search = "", ouDn = "", alias = "", warnMb = "", sendMb = "";
    private bool hidden;
    private string dgName = "", dgOu = "", dgIdentity = "", dgMember = "", trustee = "";
    private bool NoTrustee => sel is null || string.IsNullOrEmpty(trustee);
    private int page;
    private string? banner; private bool ok;

    protected override async Task OnInitializedAsync()
    {
        try { ous = (await Dir.ListAllOusAsync(Ui.BaseDn)).ToList(); } catch { ous = new(); }
        ouDn = ous.Any(o => o.Dn == Ui.UsersOu) ? Ui.UsersOu : Ui.BaseDn;
        dgOu = ous.Any(o => o.Dn == Ui.GroupsOu) ? Ui.GroupsOu : Ui.BaseDn;
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try { users = (await Dir.ListUsersAsync(ouDn, subtree: true)).ToList(); sel = null; selected.Clear(); page = 0; }
        catch (Exception ex) { Fail(ex.Message); }
    }

    private List<AdUserSummary> Filtered()
    {
        var q = users!.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(search))
        {
            var t = search.Trim();
            q = q.Where(u =>
                (u.DisplayName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.SamAccountName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return q.ToList();
    }

    private bool AllOnPageSelected(List<AdUserSummary> pageItems) => pageItems.Count > 0 && pageItems.All(u => selected.Contains(u.Dn));
    private void TogglePage(List<AdUserSummary> pageItems, ChangeEventArgs e)
    {
        var on = (bool)(e.Value ?? false);
        foreach (var u in pageItems) { if (on) selected.Add(u.Dn); else selected.Remove(u.Dn); }
    }
    private void ToggleOne(string dn, ChangeEventArgs e) { if ((bool)(e.Value ?? false)) selected.Add(dn); else selected.Remove(dn); }
    private void ClearSel() => selected.Clear();

    private void Select(AdUserSummary u) { sel = u; banner = null; }

    private async Task BulkEnable()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Ex.EnableMailboxAsync(actor, dn, null); if (r.Success) okc++; else fail++; }
        ok = fail == 0; banner = $"Enable mailbox: {okc} ok, {fail} failed."; selected.Clear();
    }

    private async Task BulkDisable()
    {
        var actor = await Actor(); int okc = 0, fail = 0;
        foreach (var dn in selected.ToList()) { var r = await Ex.DisableMailboxAsync(actor, dn); if (r.Success) okc++; else fail++; }
        ok = fail == 0; banner = $"Disable mailbox: {okc} ok, {fail} failed."; selected.Clear();
    }

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }

    private async Task EnableMailbox() => Show(await Ex.EnableMailboxAsync(await Actor(), sel!.Dn, string.IsNullOrWhiteSpace(alias) ? null : alias));
    private async Task DisableMailbox() => Show(await Ex.DisableMailboxAsync(await Actor(), sel!.Dn));

    private async Task SetProps()
    {
        long? warn = long.TryParse(warnMb, out var w) ? w : null;
        long? send = long.TryParse(sendMb, out var s) ? s : null;
        var props = new MailboxProperties(string.IsNullOrWhiteSpace(alias) ? null : alias, warn, send, hidden);
        Show(await Ex.SetMailboxPropertiesAsync(await Actor(), sel!.Dn, props));
    }

    private async Task AddFullAccess() => Show(await Ex.AddMailboxPermissionAsync(await Actor(), sel!.Dn, trustee));
    private async Task RemoveFullAccess() => Show(await Ex.RemoveMailboxPermissionAsync(await Actor(), sel!.Dn, trustee));
    private async Task AddSendAs() => Show(await Ex.AddSendAsAsync(await Actor(), sel!.Dn, trustee));
    private async Task RemoveSendAs() => Show(await Ex.RemoveSendAsAsync(await Actor(), sel!.Dn, trustee));
    private async Task AddSendOnBehalf() => Show(await Ex.SetSendOnBehalfAsync(await Actor(), sel!.Dn, trustee, add: true));
    private async Task RemoveSendOnBehalf() => Show(await Ex.SetSendOnBehalfAsync(await Actor(), sel!.Dn, trustee, add: false));

    private async Task CreateDg() { Show(await Ex.CreateDistributionGroupAsync(await Actor(), dgName.Trim(), dgOu)); }
    private async Task AddMember() { Show(await Ex.ManageDistributionMembersAsync(await Actor(), dgIdentity.Trim(), new[] { dgMember }, Array.Empty<string>())); }
    private async Task RemoveMember() { Show(await Ex.ManageDistributionMembersAsync(await Actor(), dgIdentity.Trim(), Array.Empty<string>(), new[] { dgMember })); }

    private void Show(OperationResult r) { ok = r.Success; banner = r.Success ? "Done." : ("Error: " + r.Message); }
    private void Fail(string m) { ok = false; banner = "Error: " + m; }
    private static string Indent(int d) => new string(' ', d * 3);
}
