@page "/settings"
@inject ISettingsStore Store
@inject IKeyring Keyring
@inject ISecretProtector Protector
@inject IAuditLog Audit
@inject IExchangeDataCache ExchangeCache
@inject IWebHostEnvironment Env

<PageTitle>Settings — admanager</PageTitle>
<h1>Settings</h1>
<RequireAccess Permissions="new[] { Permission.ManageSettings }">
<p class="subtitle">Runtime settings for email (SMTP), HTTPS/certificates, operational identity and secret encryption. Secrets are encrypted at rest (envelope, key outside the database).</p>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

@if (model is null)
{
    <p>Loading…</p>
}
else
{
    <div class="panel" style="max-width:640px">
        <h3>SMTP</h3>
        <label>Host</label>
        <input type="text" @bind="model.Smtp.Host" placeholder="smtp.contoso.com" />
        <div class="hint">SMTP server host name used to send reminder emails.</div>

        <div class="grid2">
            <div>
                <label>Port</label>
                <input type="number" @bind="model.Smtp.Port" placeholder="25" />
                <div class="hint">Typically 25, 465 (SSL) or 587 (STARTTLS).</div>
            </div>
            <div>
                <div class="checkbox" style="margin-top:26px"><input type="checkbox" id="ssl" @bind="model.Smtp.UseSsl" /><label for="ssl">Use SSL/TLS</label></div>
            </div>
        </div>

        <label>From address</label>
        <input type="text" @bind="model.Smtp.From" placeholder="it-noreply@contoso.com" />
        <div class="hint">Sender shown on reminder emails.</div>

        <div class="grid2">
            <div>
                <label>User (optional)</label>
                <input type="text" @bind="model.Smtp.User" placeholder="leave empty for anonymous relay" />
                <div class="hint">SMTP auth user, if the relay requires it.</div>
            </div>
            <div>
                <label>Password (optional)</label>
                <input type="password" @bind="model.Smtp.Password" />
                <div class="hint">SMTP auth password. Encrypted at rest (envelope, AES-256-GCM).</div>
            </div>
        </div>
    </div>

    <div class="panel" style="max-width:640px;margin-top:16px" id="https">
        <h3>HTTPS / Certificates</h3>
        <div class="checkbox"><input type="checkbox" id="rq" @bind="model.Https.RequireHttps" /><label for="rq">Require HTTPS (redirect HTTP → HTTPS)</label></div>
        <div class="hint">Enforce TLS for the admin portal. Applied at the web-host level.</div>
        <div class="checkbox"><input type="checkbox" id="hsts" @bind="model.Https.UseHsts" /><label for="hsts">Enable HSTS</label></div>
        <div class="hint">Send Strict-Transport-Security so browsers only use HTTPS. Enable only after HTTPS is verified.</div>

        <label>Certificate source</label>
        <select @bind="model.Https.CertificateSource">
            <option value="IIS">IIS binding (managed by IIS)</option>
            <option value="PfxFile">PFX file</option>
            <option value="Store">Windows cert store (by thumbprint)</option>
        </select>
        <div class="hint">Where the TLS certificate comes from. In the IIS lab, the binding is managed in IIS Manager.</div>

        @if (model.Https.CertificateSource == "PfxFile")
        {
            <label>PFX certificate file</label>
            <div class="uploadrow">
                <label class="btn uploadbtn">
                    Choose PFX file…
                    <InputFile OnChange="OnPfxSelected" accept=".pfx,.p12" style="display:none" />
                </label>
                <span class="uploadname">
                    @if (!string.IsNullOrEmpty(pfxUploadName)) { <text>@pfxUploadName</text> }
                    else if (!string.IsNullOrEmpty(model.Https.PfxPath)) { <text>@System.IO.Path.GetFileName(model.Https.PfxPath)</text> }
                    else { <span class="muted">no file selected</span> }
                </span>
            </div>
            <div class="hint">Upload a .pfx/.p12 certificate. Stored under App_Data on the server; the path is filled in automatically.</div>
            @if (pfxError is { Length: > 0 }) { <div class="hint" style="color:var(--danger)">@pfxError</div> }

            <label>PFX password</label>
            <input type="password" @bind="model.Https.PfxPassword" />
            <div class="hint">Password for the PFX file. Encrypted at rest (envelope, AES-256-GCM).</div>
        }
        else if (model.Https.CertificateSource == "Store")
        {
            <label>Certificate thumbprint</label>
            <input type="text" @bind="model.Https.Thumbprint" placeholder="A1B2C3… (no spaces)" />
            <div class="hint">SHA-1 thumbprint of a certificate in LocalMachine\My.</div>
        }

        <label>HTTPS port</label>
        <input type="number" @bind="model.Https.HttpsPort" placeholder="443" />

        <div class="banner" style="margin-top:10px">Note: certificate binding changes take effect at the web-host level (IIS site binding or Kestrel). This page stores the intended configuration.</div>
    </div>

    <div class="panel" style="max-width:640px;margin-top:16px" id="identity">
        <h3>Operational identity</h3>
        <div class="hint">Account used to perform AD/Exchange operations on behalf of technicians (never Domain Admin). Default is gMSA (no stored password).</div>

        <label>Mode</label>
        <select @bind="model.OperationalCredential.Mode">
            <option value="gMSA">gMSA (group managed service account — no password)</option>
            <option value="StoredCredential">Stored credential (domain account with password)</option>
        </select>
        <div class="hint">gMSA is recommended: the password is managed by AD and never stored here.</div>

        @if (model.OperationalCredential.Mode == "StoredCredential")
        {
            <div class="grid2">
                <div>
                    <label>User</label>
                    <input type="text" @bind="model.OperationalCredential.User" placeholder="svc-admanager" />
                    <div class="hint">sAMAccountName or UPN of the operational account.</div>
                </div>
                <div>
                    <label>Domain</label>
                    <input type="text" @bind="model.OperationalCredential.Domain" placeholder="contoso.com" />
                    <div class="hint">Account domain (NetBIOS or FQDN).</div>
                </div>
            </div>
            <label>Password</label>
            <input type="password" @bind="model.OperationalCredential.Password" />
            <div class="hint">Password of the operational account. Encrypted at rest (envelope, AES-256-GCM).</div>
        }
    </div>

    <div class="panel" style="max-width:640px;margin-top:16px" id="secrets">
        <h3>Secret encryption</h3>
        <div class="hint">Secrets (SMTP / PFX / operational password) are encrypted with an application key stored outside the database. Back up the key separately from the database — see docs/backup-dr.md.</div>
        <label>Key fingerprint</label>
        <input type="text" value="@keyFingerprint" readonly />
        <div class="hint">Short fingerprint of the current key (not the key itself). Use it to verify a key backup matches.</div>

        <div class="btnrow" style="margin-top:12px">
            @if (!confirmRotate)
            {
                <button class="danger" @onclick="() => confirmRotate = true">Rotate encryption key…</button>
            }
            else
            {
                <button class="danger" @onclick="RotateKey" disabled="@rotating">Confirm rotate key</button>
                <button @onclick="() => confirmRotate = false" disabled="@rotating">Cancel</button>
            }
        </div>
        <div class="hint">Generates a new key and re-encrypts all stored secrets with it. Back up the new key afterwards; the old key stops being used.</div>
    </div>

    <div class="panel" style="max-width:640px;margin-top:16px" id="audit">
        <h3>Audit logs</h3>
        <label>Retention (days)</label>
        <input type="number" min="0" @bind="model.AuditRetentionDays" />
        <div class="hint">How long audit / logon records are kept. Records older than this are removed daily. 0 = keep forever.</div>
    </div>

    <div class="panel" style="max-width:640px;margin-top:16px" id="exchange">
        <h3>Exchange cache</h3>
        <div class="hint">Exchange data is expensive to query (remote PowerShell), so it is cached on a schedule.</div>

        <div class="grid2">
            <div>
                <label>Mailbox database list — refresh every (hours)</label>
                <input type="number" min="1" @bind="model.ExchangeCache.DatabaseListRefreshHours" />
                <div class="hint">List of mailbox databases (for the Create-mailbox selectors). Default 24.</div>
            </div>
            <div>
                <label>Mailbox attributes — refresh every (hours)</label>
                <input type="number" min="1" @bind="model.ExchangeCache.MailboxAttributesRefreshHours" />
                <div class="hint">Cached mailbox attributes (AD + Exchange). Default 6.</div>
            </div>
        </div>

        <div class="hint" style="margin-top:8px">
            Databases cached: <strong>@ExchangeCache.Databases.Count</strong>
            @if (ExchangeCache.DatabasesRefreshedUtc is { } t) { <text> · last refresh @MskTime.ToMsk(t).ToString("yyyy-MM-dd HH:mm") МСК</text> }
        </div>
        <div class="btnrow" style="margin-top:8px">
            <button @onclick="ForceExchangeRefresh" disabled="@exRefreshing">@(exRefreshing ? "Refreshing…" : "Force refresh now")</button>
        </div>
        <div class="hint">Immediately re-reads the mailbox database list from Exchange.</div>
    </div>

    <div class="btnrow" style="margin-top:16px;max-width:640px">
        <button class="primary" @onclick="Save">Save settings</button>
    </div>
}
</RequireAccess>

@code {
    private AppSettings? model;
    private string? banner; private bool ok;
    private bool confirmRotate; private bool rotating;
    private string keyFingerprint = "";
    private string? pfxUploadName; private string? pfxError;
    private bool exRefreshing;

    private const long MaxPfxBytes = 512 * 1024; // 512 KB — сертификат заведомо мал

    private async Task OnPfxSelected(InputFileChangeEventArgs e)
    {
        pfxError = null;
        var file = e.File;
        if (file is null) return;
        if (file.Size > MaxPfxBytes) { pfxError = "File too large (max 512 KB for a certificate)."; return; }
        var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".pfx" or ".p12")) { pfxError = "Only .pfx / .p12 files are allowed."; return; }
        try
        {
            var dir = System.IO.Path.Combine(Env.ContentRootPath, "App_Data", "certs");
            System.IO.Directory.CreateDirectory(dir);
            var safe = "admanager-" + DateTime.UtcNow.ToString("yyyyMMddHHmmss") + ext;
            var dest = System.IO.Path.Combine(dir, safe);
            await using (var fs = new FileStream(dest, FileMode.Create, FileAccess.Write))
            await using (var rs = file.OpenReadStream(MaxPfxBytes))
            {
                await rs.CopyToAsync(fs);
            }
            if (model is not null) model.Https.PfxPath = dest;
            pfxUploadName = file.Name;
        }
        catch (Exception ex) { pfxError = "Upload failed: " + ex.Message; }
    }

    private async Task ForceExchangeRefresh()
    {
        exRefreshing = true;
        try { await ExchangeCache.RefreshDatabasesAsync(); ok = true; banner = $"Exchange database list refreshed ({ExchangeCache.Databases.Count} databases)."; }
        catch (Exception ex) { ok = false; banner = "Refresh failed: " + ex.Message; }
        finally { exRefreshing = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        model = await Store.LoadAsync();
        keyFingerprint = Keyring.KeyFingerprint();
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task Save()
    {
        if (model is null) return;
        try
        {
            await Store.SaveAsync(model); ok = true; banner = "Settings saved.";
            var p = AuthState is null ? null : (await AuthState).User;
            await ConfigAudit.WriteAsync(Audit, CurrentUser.From(p), "Settings", "Application settings", "Modified");
        }
        catch (Exception ex) { ok = false; banner = "Error: " + ex.Message; }
    }

    private async Task RotateKey()
    {
        rotating = true;
        try
        {
            // Порядок важен: сначала прочитать секреты СТАРЫМ ключом (декоратор
            // расшифрует), затем сменить ключ, затем записать — декоратор зашифрует
            // НОВЫМ ключом. Так все секреты в БД перешифровываются.
            var current = await Store.LoadAsync();   // plaintext (old key)
            Keyring.Rotate();                        // key changes on disk
            await Store.SaveAsync(current);          // re-encrypted with new key
            keyFingerprint = Keyring.KeyFingerprint();
            model = await Store.LoadAsync();         // refresh view
            ok = true;
            banner = $"Encryption key rotated. New fingerprint: {keyFingerprint}. Back up the new key (docs/backup-dr.md).";
        }
        catch (Exception ex) { ok = false; banner = "Rotate failed: " + ex.Message; }
        finally { rotating = false; confirmRotate = false; }
    }
}
