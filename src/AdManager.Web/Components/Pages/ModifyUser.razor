@page "/users/modify"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject IUserTemplateStore Templates
@inject NavigationManager Nav

<PageTitle>Modify user — admanager</PageTitle>
<h1>Modify user</h1>
<p class="subtitle">@Dn</p>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

@if (model is null)
{
    <p>Loading…</p>
}
else
{
    <div class="panel" style="max-width:420px">
        <label>Layout template</label>
        <select @bind="templateSel" @bind:after="OnTemplateChange">
            <option value="">(default)</option>
            @foreach (var t in templates)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>
    </div>

    <div class="tabbar">
        @for (int i = 0; i < Layout.Count; i++)
        {
            var idx = i;
            <button class="tabbtn @(sel == idx ? "on" : null)" @onclick="() => sel = idx">@Layout[idx].Title</button>
        }
    </div>

    <div class="panel" style="max-width:640px">
        @foreach (var f in CurrentTab.Fields)
        {
            var key = f.Key;
            var req = f.Required ? " *" : "";
            @if (key == "sAMAccountName")
            {
                <label>SAM account name</label>
                <input type="text" value="@sam" disabled />
            }
            else if (key == "__enabled")
            {
                <div class="checkbox"><input type="checkbox" id="en" checked="@enabled" @onchange="ToggleEnabled" /><label for="en">Account enabled</label></div>
            }
            else if (key == "__pwdNeverExpires")
            {
                <div class="checkbox"><input type="checkbox" id="pne" checked="@pne" @onchange="TogglePne" /><label for="pne">Password never expires</label></div>
            }
            else if (key == "__mustChange")
            {
                <div class="btnrow"><button @onclick="ForceChange">Force change at next logon</button></div>
            }
            else if (key == "__password")
            {
                <label>Reset password</label>
                <div class="toolbar" style="margin:4px 0">
                    <input type="password" class="grow" @bind="resetPwd" placeholder="new password" />
                    <button @onclick="ResetPassword" disabled="@string.IsNullOrEmpty(resetPwd)">Reset</button>
                </div>
            }
            else
            {
                <label>@FieldCatalog.Label(key)@(req)</label>
                <input type="text" value="@model.GetValueOrDefault(key)" @onchange="e => model[key] = e.Value?.ToString()" />
                @if (key == "userPrincipalName") { <div class="hint">Empty UPN is not cleared.</div> }
                else if (key == "manager") { <div class="hint">Full DN, e.g. <code>CN=Boss,OU=…,DC=Merl,DC=loc</code>.</div> }
            }
        }

        <hr />
        <label>Account expires</label>
        <input type="date" @bind="expiry" />
        <div class="btnrow">
            <button @onclick="SetExpiry" disabled="@(expiry is null)">Set expiry</button>
            <button @onclick="ClearExpiry">Clear (never)</button>
        </div>

        <div class="btnrow" style="margin-top:16px">
            <button class="primary" @onclick="SaveAll">Save attributes</button>
            <button @onclick='() => Nav.NavigateTo("users")'>Back to users</button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] private string? Dn { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly string[] TextKeys = FieldCatalog.All
        .Where(f => !FieldCatalog.IsSpecial(f.Key)).Select(f => f.Key).Distinct().ToArray();

    private List<UserTemplate> templates = new();
    private UserTemplate? selectedTemplate;
    private string templateSel = "";
    private readonly List<TemplateTab> defaultLayout = TemplateDefaults.Modify();

    private Dictionary<string, string?>? model;
    private int sel;
    private string sam = "", resetPwd = "";
    private bool pne, enabled;
    private DateTime? expiry;
    private string? banner; private bool ok;

    private List<TemplateTab> Layout => selectedTemplate?.Tabs is { Count: > 0 } t ? t : defaultLayout;
    private TemplateTab CurrentTab => Layout[Math.Min(sel, Layout.Count - 1)];

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Dn)) { banner = "No user specified."; ok = false; return; }
        var wanted = TextKeys.Concat(new[] { "sAMAccountName", "userAccountControl" }).ToArray();
        var det = await Dir.GetObjectAsync(Dn, wanted);
        model = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var k in TextKeys) model[k] = det?.Attributes.GetValueOrDefault(k);
        sam = det?.Attributes.GetValueOrDefault("sAMAccountName") ?? "";
        var uac = int.TryParse(det?.Attributes.GetValueOrDefault("userAccountControl"), out var v) ? v : 0;
        pne = (uac & 0x10000) != 0;
        enabled = (uac & 0x2) == 0;
        templates = (await Templates.ListAsync()).Where(t => t.Kind == "Modify").ToList();
    }

    private void OnTemplateChange()
    {
        selectedTemplate = Guid.TryParse(templateSel, out var id) ? templates.FirstOrDefault(t => t.Id == id) : null;
        sel = 0;
    }

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }

    private async Task SaveAll()
    {
        // Обязательные текстовые поля раскладки
        var miss = Layout.SelectMany(t => t.Fields)
            .Where(f => f.Required && !FieldCatalog.IsSpecial(f.Key) && string.IsNullOrWhiteSpace(model!.GetValueOrDefault(f.Key)))
            .Select(f => FieldCatalog.Label(f.Key)).Distinct().ToList();
        if (miss.Count > 0) { ok = false; banner = "Required: " + string.Join(", ", miss); return; }

        // Пишем только текстовые поля, присутствующие в текущей раскладке (шаблон ограничивает объём).
        var layoutKeys = Layout.SelectMany(t => t.Fields).Select(f => f.Key)
            .Where(k => !FieldCatalog.IsSpecial(k)).Distinct().ToList();
        var attrs = new Dictionary<string, string?>();
        foreach (var k in layoutKeys)
        {
            var val = model!.GetValueOrDefault(k);
            if (k == "userPrincipalName" && string.IsNullOrEmpty(val)) continue; // не очищать UPN
            attrs[k] = val;
        }
        if (attrs.Count == 0) { ok = true; banner = "No editable attributes in this layout."; return; }
        Show(await Mgmt.SetAttributesAsync(await Actor(), Dn!, attrs));
    }

    private async Task ToggleEnabled(ChangeEventArgs e)
    {
        enabled = (bool)(e.Value ?? false);
        Show(await Mgmt.SetEnabledAsync(await Actor(), Dn!, enabled));
    }
    private async Task TogglePne(ChangeEventArgs e)
    {
        pne = (bool)(e.Value ?? false);
        Show(await Mgmt.SetAccountOptionsAsync(await Actor(), Dn!, new AccountOptions(PasswordNeverExpires: pne)));
    }
    private async Task ForceChange() => Show(await Mgmt.SetAccountOptionsAsync(await Actor(), Dn!, new AccountOptions(MustChangePasswordAtNextLogon: true)));
    private async Task ResetPassword()
    {
        Show(await Mgmt.ResetPasswordAsync(await Actor(), Dn!, resetPwd, false));
        resetPwd = "";
    }
    private async Task SetExpiry() => Show(await Mgmt.SetAccountOptionsAsync(await Actor(), Dn!, new AccountOptions(AccountExpiresUtc: expiry)));
    private async Task ClearExpiry() { expiry = null; Show(await Mgmt.SetAccountOptionsAsync(await Actor(), Dn!, new AccountOptions(ClearAccountExpiry: true))); }

    private void Show(OperationResult r) { ok = r.Success; banner = r.Success ? "Saved." : ("Error: " + r.Message); }
}
