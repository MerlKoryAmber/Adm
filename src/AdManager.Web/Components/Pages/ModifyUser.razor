@page "/users/modify"
@inject IAdDirectory Dir
@inject AdManagementService Mgmt
@inject IRbacEngine Rbac
@inject IUserTemplateStore Templates
@inject UiOptions Ui
@inject NavigationManager Nav

<PageTitle>Modify user — admanager</PageTitle>
<h1>Modify user</h1>
<p class="subtitle">@(model is null ? "" : $"{model.GetValueOrDefault("displayName")} ({sam}) — {Rdn(ParentOf(Dn))}")</p>

@if (banner is not null)
{
    <div class="banner @(ok ? "ok" : "err")">@banner</div>
}

@if (model is null)
{
    <p>Loading…</p>
}
else
{
    <div class="panel" style="max-width:420px">
        <label>Layout template</label>
        <select @bind="templateSel" @bind:after="OnTemplateChange">
            <option value="">(default)</option>
            @foreach (var t in templates)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>
    </div>

    <div class="tabbar">
        @for (int i = 0; i < Layout.Count; i++)
        {
            var idx = i;
            <button class="tabbtn @(sel == idx ? "on" : null)" @onclick="() => sel = idx">@Layout[idx].Title</button>
        }
    </div>

    <div class="panel" style="max-width:640px">
        @foreach (var f in CurrentTab.Fields)
        {
            var key = f.Key;
            var req = f.Required ? " *" : "";
            if (!allowedFields.Allows(key)) { continue; }
            @if (key == "sAMAccountName")
            {
                <label>SAM account name</label>
                <input type="text" value="@sam" disabled />
            }
            else if (key == "__enabled")
            {
                <div class="checkbox"><input type="checkbox" id="en" checked="@enabled" @onchange="ToggleEnabled" /><label for="en">Account enabled</label></div>
            }
            else if (key == "__pwdNeverExpires")
            {
                <div class="checkbox"><input type="checkbox" id="pne" checked="@pne" @onchange="TogglePne" /><label for="pne">Password never expires</label></div>
            }
            else if (key == "__mustChange")
            {
                <div class="btnrow"><button @onclick="ForceChange">Force change at next logon</button></div>
            }
            else if (key == "__password")
            {
                <label>Reset password</label>
                <div class="toolbar" style="margin:4px 0">
                    <input type="password" class="grow" @bind="resetPwd" placeholder="new password" />
                    <button @onclick="ResetPassword" disabled="@string.IsNullOrEmpty(resetPwd)">Reset</button>
                </div>
            }
            else if (key is "__cannotChangePwd" or "__reversibleEncryption" or "__smartcardRequired" or "__notDelegated" or "__desOnly" or "__noPreauth")
            {
                var k = key;
                <div class="checkbox"><input type="checkbox" checked="@uacFlags.GetValueOrDefault(k)" @onchange="e => ToggleUac(k, (bool)(e.Value ?? false))" /><label>@FieldCatalog.Label(k)</label></div>
                @if (k == "__cannotChangePwd") { <div class="hint">Written as UAC bit 0x40; in AD "cannot change password" is enforced via ACL, so effect is limited (ACL variant is a separate step).</div> }
            }
            else if (key == "__logonHours")
            {
                <label>Logon hours (UTC)</label>
                <div class="hint">Green = logon allowed. Times are UTC — ADUC displays them shifted to local time.</div>
                <div style="overflow-x:auto">
                    <table class="lh">
                        <thead>
                            <tr><th></th>@for (int h = 0; h < 24; h++) { <th>@h</th> }</tr>
                        </thead>
                        <tbody>
                            @for (int d = 0; d < 7; d++)
                            {
                                var dd = d;
                                <tr>
                                    <th>@Days[dd]</th>
                                    @for (int h = 0; h < 24; h++)
                                    {
                                        var hh = h;
                                        <td class="@(logonGrid[dd, hh] ? "on" : "off")" title="@Days[dd] @hh:00" @onclick="() => logonGrid[dd, hh] = !logonGrid[dd, hh]"></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="btnrow">
                    <button @onclick="() => FillLogon(true)">Allow all</button>
                    <button @onclick="() => FillLogon(false)">Deny all</button>
                    <button class="primary" @onclick="SaveLogonHours">Save hours</button>
                    <button @onclick="ClearLogonHours">Clear (always allowed)</button>
                </div>
            }
            else if (key == "__country")
            {
                <label>Country/region</label>
                <select value="@(model.GetValueOrDefault("c") ?? "")" @onchange="OnCountryChange">
                    @foreach (var cty in Countries.All)
                    {
                        <option value="@cty.Iso2">@cty.Name</option>
                    }
                </select>
                <div class="hint">Sets c (ISO2), co (name) and countryCode (numeric) together.</div>
            }
            else if (key == "__homeFolder")
            {
                <label>Home folder</label>
                <div class="checkbox"><input type="checkbox" id="hc" @bind="homeConnect" /><label for="hc">Connect a drive (network home)</label></div>
                @if (homeConnect)
                {
                    <div class="toolbar" style="margin:4px 0">
                        <select @bind="homeDriveSel" style="max-width:90px">
                            @foreach (var d in Drives) { <option value="@d">@d</option> }
                        </select>
                        <input class="grow" @bind="homePath" placeholder="\\\\server\\share\\%username%" />
                    </div>
                }
                else
                {
                    <input type="text" @bind="homePath" placeholder="local path, e.g. C:\Users\jdoe" />
                }
                <div class="btnrow"><button @onclick="ApplyHomeFolder">Apply home folder</button></div>
            }
            else if (OtherAttr(key) is { Length: > 0 })
            {
                var k = key;
                <label>@FieldCatalog.Label(k)</label>
                @if (otherVals.TryGetValue(k, out var vals) && vals.Count > 0)
                {
                    <div class="fieldlist">
                        @foreach (var val in vals.ToList())
                        {
                            var vv = val;
                            <div class="fieldrow"><span class="fname">@vv</span><span class="grow"></span><button class="linkbtn danger" @onclick="() => RemoveOther(k, vv)">Remove</button></div>
                        }
                    </div>
                }
                <div class="toolbar" style="margin:4px 0">
                    <input class="grow" value="@(otherInput.GetValueOrDefault(k) ?? "")" @onchange="e => otherInput[k] = e.Value?.ToString() ?? string.Empty" placeholder="add value…" />
                    <button @onclick="() => AddOther(k)">Add</button>
                </div>
            }
            else if (key == "manager")
            {
                <label>Manager</label>
                <div class="toolbar" style="margin:4px 0">
                    <span class="grow">@(string.IsNullOrEmpty(managerDisplay) ? "— none —" : managerDisplay)</span>
                    @if (!string.IsNullOrEmpty(managerDisplay)) { <button class="linkbtn danger" @onclick="ClearManager">Clear</button> }
                </div>
                <div class="toolbar" style="margin:4px 0">
                    <input class="grow" type="text" placeholder="find user by name…" @bind="managerSearch" @bind:event="oninput" />
                    <button @onclick="FindManager" disabled="@(string.IsNullOrWhiteSpace(managerSearch))">Find</button>
                </div>
                @if (managerResults is { Count: > 0 })
                {
                    <div class="fieldlist">
                        @foreach (var m in managerResults)
                        {
                            var mm = m;
                            <div class="fieldrow"><span class="fname">@mm.Name</span><span class="fkey">@mm.SamAccountName</span><span class="grow"></span><button class="linkbtn" @onclick="() => PickManager(mm)">Select</button></div>
                        }
                    </div>
                }
            }
            else if (key == "__memberOf")
            {
                <label>Member of</label>
                @if (userGroups is { Count: > 0 })
                {
                    <div class="fieldlist">
                        @foreach (var g in userGroups)
                        {
                            var gg = g;
                            <div class="fieldrow"><span class="fname">@gg.Name</span><span class="grow"></span><button class="linkbtn danger" @onclick="() => RemoveFromGroup(gg.Dn)">Remove</button></div>
                        }
                    </div>
                }
                else { <div class="hint">Not a member of any group (besides primary).</div> }
                <div class="toolbar" style="margin:6px 0">
                    <select class="grow" @bind="addGroupDn">
                        <option value="">— add to group —</option>
                        @foreach (var g in allGroups ?? Enumerable.Empty<AdGroupSummary>())
                        {
                            <option value="@g.Dn">@g.Name</option>
                        }
                    </select>
                    <button @onclick="AddToGroup" disabled="@string.IsNullOrEmpty(addGroupDn)">Add</button>
                </div>
            }
            else if (key == "__primaryGroup")
            {
                <label>Primary group</label>
                <div class="toolbar" style="margin:4px 0">
                    <select class="grow" @bind="primaryGroupSel">
                        <option value="">— select a group the user belongs to —</option>
                        @foreach (var g in userGroups ?? Enumerable.Empty<AdGroupSummary>())
                        {
                            <option value="@g.Dn">@g.Name</option>
                        }
                    </select>
                    <button @onclick="SetPrimary" disabled="@string.IsNullOrEmpty(primaryGroupSel)">Set primary</button>
                </div>
                <div class="hint">User must already be a member of the chosen group.</div>
            }
            else
            {
                <label>@FieldCatalog.Label(key)@(req)</label>
                <input type="text" value="@model.GetValueOrDefault(key)" @onchange="e => model[key] = e.Value?.ToString()" />
                @if (key == "userPrincipalName") { <div class="hint">Empty UPN is not cleared.</div> }
            }
        }

        <hr />
        <label>Account expires</label>
        <input type="date" @bind="expiry" />
        <div class="btnrow">
            <button @onclick="SetExpiry" disabled="@(expiry is null)">Set expiry</button>
            <button @onclick="ClearExpiry">Clear (never)</button>
        </div>

        <div class="btnrow" style="margin-top:16px">
            <button class="primary" @onclick="SaveAll">Save attributes</button>
            <button @onclick='() => Nav.NavigateTo("users")'>Back to users</button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] private string? Dn { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly string[] TextKeys = FieldCatalog.All
        .Where(f => !FieldCatalog.IsSpecial(f.Key)).Select(f => f.Key).Distinct().ToArray();

    private List<UserTemplate> templates = new();
    private UserTemplate? selectedTemplate;
    private string templateSel = "";
    private readonly List<TemplateTab> defaultLayout = TemplateDefaults.Modify();

    private Dictionary<string, string?>? model;
    private Dictionary<string, string?> original = new(StringComparer.OrdinalIgnoreCase); // для dirty-tracking
    private int sel;
    private string sam = "", resetPwd = "";
    private bool pne, enabled;
    private readonly Dictionary<string, bool> uacFlags = new(); // __cannotChangePwd/__reversibleEncryption/... из userAccountControl
    private List<AdGroupSummary>? userGroups;   // memberOf (читаемые имена)
    private List<AdGroupSummary>? allGroups;    // для добавления в группу
    private string addGroupDn = "", primaryGroupSel = "";
    private string managerSearch = "", managerDisplay = "";
    private List<AdSearchResult>? managerResults;
    private readonly bool[,] logonGrid = new bool[7, 24];
    private static readonly string[] Days = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
    private bool homeConnect;
    private string homeDriveSel = "Z:", homePath = "";
    private static readonly string[] Drives = { "Z:", "Y:", "X:", "W:", "V:", "U:", "T:", "S:", "R:", "Q:", "P:", "O:", "N:", "M:", "L:", "K:", "J:", "I:", "H:", "G:", "F:", "E:", "D:" };
    private static readonly (string Key, string Attr)[] OtherKeys =
    {
        ("__otherTelephone", "otherTelephone"), ("__otherHomePhone", "otherHomePhone"), ("__otherPager", "otherPager"),
        ("__otherMobile", "otherMobile"), ("__otherFax", "otherFacsimileTelephoneNumber"), ("__otherIpPhone", "otherIpPhone"),
        ("__otherWeb", "url"),
    };
    private static string OtherAttr(string key) => OtherKeys.FirstOrDefault(x => x.Key == key).Attr ?? "";
    private readonly Dictionary<string, List<string>> otherVals = new();
    private readonly Dictionary<string, string> otherInput = new();
    private DateTime? expiry;
    private string? banner; private bool ok;

    private List<TemplateTab> Layout => selectedTemplate?.Tabs is { Count: > 0 } t ? t : defaultLayout;
    private TemplateTab CurrentTab => Layout[Math.Min(sel, Layout.Count - 1)];

    private FieldPermission allowedFields = FieldPermission.All;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Dn)) { banner = "No user specified."; ok = false; return; }
        try
        {
            allowedFields = await Rbac.AllowedFieldsAsync(await Actor(), Permission.ModifyAttributes, Dn);
            var wanted = TextKeys.Concat(new[] { "sAMAccountName", "userAccountControl" }).ToArray();
            var det = await Dir.GetObjectAsync(Dn, wanted);
            if (det is null) { banner = "User not found (may have been moved or deleted)."; ok = false; return; }
            model = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
            foreach (var k in TextKeys) model[k] = det.Attributes.GetValueOrDefault(k);
            original = new Dictionary<string, string?>(model, StringComparer.OrdinalIgnoreCase); // снимок для dirty-tracking
            sam = det.Attributes.GetValueOrDefault("sAMAccountName") ?? "";
            var uac = int.TryParse(det.Attributes.GetValueOrDefault("userAccountControl"), out var v) ? v : 0;
            pne = (uac & 0x10000) != 0;
            enabled = (uac & 0x2) == 0;
            uacFlags["__cannotChangePwd"] = (uac & 0x40) != 0;
            uacFlags["__reversibleEncryption"] = (uac & 0x80) != 0;
            uacFlags["__smartcardRequired"] = (uac & 0x40000) != 0;
            uacFlags["__notDelegated"] = (uac & 0x100000) != 0;
            uacFlags["__desOnly"] = (uac & 0x200000) != 0;
            uacFlags["__noPreauth"] = (uac & 0x400000) != 0;
            templates = (await Templates.ListAsync()).Where(t => t.Kind == "Modify").ToList();
            userGroups = (await Dir.ListUserGroupsAsync(Dn)).ToList();
            allGroups = (await Dir.ListGroupsAsync(Ui.BaseDn, subtree: true)).ToList();
            managerDisplay = Rdn(model.GetValueOrDefault("manager"));
            UnpackLogon(await Dir.GetLogonHoursAsync(Dn));
            homePath = model.GetValueOrDefault("homeDirectory") ?? "";
            var hd = model.GetValueOrDefault("homeDrive");
            homeConnect = !string.IsNullOrEmpty(hd);
            if (homeConnect) homeDriveSel = hd!;
            foreach (var (k, attr) in OtherKeys) otherVals[k] = (await Dir.GetMultiValueAsync(Dn, attr)).ToList();
        }
        catch (Exception ex) { ok = false; banner = "Error loading user: " + ex.Message; }
    }

    private void OnTemplateChange()
    {
        selectedTemplate = Guid.TryParse(templateSel, out var id) ? templates.FirstOrDefault(t => t.Id == id) : null;
        sel = 0;
    }

    private async Task<TechnicianContext> Actor()
    {
        var p = AuthState is null ? null : (await AuthState).User;
        return CurrentUser.From(p);
    }

    private async Task SaveAll()
    {
        // Обязательные текстовые поля раскладки
        var miss = Layout.SelectMany(t => t.Fields)
            .Where(f => f.Required && !FieldCatalog.IsSpecial(f.Key) && string.IsNullOrWhiteSpace(model!.GetValueOrDefault(f.Key)))
            .Select(f => FieldCatalog.Label(f.Key)).Distinct().ToList();
        if (miss.Count > 0) { ok = false; banner = "Required: " + string.Join(", ", miss); return; }

        // Пишем ТОЛЬКО изменённые текстовые поля текущей раскладки (dirty-tracking):
        // это исключает тихую перезапись невидимых/нетронутых атрибутов (в т.ч. схлопывание multi-valued).
        var layoutKeys = Layout.SelectMany(t => t.Fields).Select(f => f.Key)
            .Where(k => !FieldCatalog.IsSpecial(k)).Distinct().ToList();
        var attrs = new Dictionary<string, string?>();
        foreach (var k in layoutKeys)
        {
            var val = model!.GetValueOrDefault(k);
            if (string.Equals(val ?? "", original.GetValueOrDefault(k) ?? "", StringComparison.Ordinal)) continue; // не менялось
            if (k == "userPrincipalName" && string.IsNullOrEmpty(val)) continue; // не очищать UPN
            attrs[k] = val;
        }
        if (attrs.Count == 0) { ok = true; banner = "No changes to save."; return; }
        var r = await Mgmt.SetAttributesAsync(await Actor(), Dn!, attrs);
        if (r.Success) foreach (var (k, v) in attrs) original[k] = v; // новый базовый снимок
        Show(r);
    }

    private async Task ToggleEnabled(ChangeEventArgs e)
    {
        enabled = (bool)(e.Value ?? false);
        Show(await Mgmt.SetEnabledAsync(await Actor(), Dn!, enabled));
    }
    private async Task TogglePne(ChangeEventArgs e)
    {
        pne = (bool)(e.Value ?? false);
        Show(await Mgmt.SetAccountOptionsAsync(await Actor(), Dn!, new AccountOptions(PasswordNeverExpires: pne)));
    }
    private async Task ForceChange() => Show(await Mgmt.SetAccountOptionsAsync(await Actor(), Dn!, new AccountOptions(MustChangePasswordAtNextLogon: true)));

    private async Task ToggleUac(string key, bool value)
    {
        uacFlags[key] = value;
        var o = key switch
        {
            "__cannotChangePwd" => new AccountOptions(CannotChangePassword: value),
            "__reversibleEncryption" => new AccountOptions(ReversibleEncryption: value),
            "__smartcardRequired" => new AccountOptions(SmartcardRequired: value),
            "__notDelegated" => new AccountOptions(NotDelegated: value),
            "__desOnly" => new AccountOptions(UseDesKeyOnly: value),
            "__noPreauth" => new AccountOptions(DontRequirePreauth: value),
            _ => new AccountOptions(),
        };
        Show(await Mgmt.SetAccountOptionsAsync(await Actor(), Dn!, o));
    }

    private async Task ReloadGroups() => userGroups = (await Dir.ListUserGroupsAsync(Dn!)).ToList();

    private async Task AddToGroup()
    {
        var g = addGroupDn; addGroupDn = "";
        Show(await Mgmt.ManageGroupMembershipAsync(await Actor(), g, new[] { Dn! }, Array.Empty<string>()));
        await ReloadGroups();
    }

    private async Task RemoveFromGroup(string groupDn)
    {
        Show(await Mgmt.ManageGroupMembershipAsync(await Actor(), groupDn, Array.Empty<string>(), new[] { Dn! }));
        await ReloadGroups();
    }

    private async Task SetPrimary()
    {
        Show(await Mgmt.SetPrimaryGroupAsync(await Actor(), Dn!, primaryGroupSel));
    }

    private async Task FindManager()
    {
        managerResults = (await Dir.SearchAsync(Ui.BaseDn, managerSearch.Trim()))
            .Where(x => (x.ObjectClass?.Contains("user", StringComparison.OrdinalIgnoreCase) ?? false)
                        && !(x.ObjectClass?.Contains("computer", StringComparison.OrdinalIgnoreCase) ?? false))
            .Take(10).ToList();
    }

    private void PickManager(AdSearchResult m) { model!["manager"] = m.Dn; managerDisplay = m.Name; managerResults = null; managerSearch = ""; }
    private void ClearManager() { model!["manager"] = ""; managerDisplay = ""; }

    // ---- logon hours (168 бит = 7×24, UTC; байт=idx/8, бит=idx%8, idx=day*24+hour) ----
    private void UnpackLogon(byte[]? mask)
    {
        for (int d = 0; d < 7; d++)
            for (int h = 0; h < 24; h++)
            {
                if (mask is null || mask.Length != 21) { logonGrid[d, h] = true; continue; } // не задано = разрешено всегда
                var idx = d * 24 + h;
                logonGrid[d, h] = ((mask[idx / 8] >> (idx % 8)) & 1) != 0;
            }
    }

    private byte[] PackLogon()
    {
        var bytes = new byte[21];
        for (int d = 0; d < 7; d++)
            for (int h = 0; h < 24; h++)
                if (logonGrid[d, h]) { var idx = d * 24 + h; bytes[idx / 8] |= (byte)(1 << (idx % 8)); }
        return bytes;
    }

    private void FillLogon(bool value)
    {
        for (int d = 0; d < 7; d++) for (int h = 0; h < 24; h++) logonGrid[d, h] = value;
    }

    private async Task SaveLogonHours() => Show(await Mgmt.SetLogonHoursAsync(await Actor(), Dn!, PackLogon()));
    private async Task ClearLogonHours()
    {
        Show(await Mgmt.SetLogonHoursAsync(await Actor(), Dn!, null));
        FillLogon(true);
    }

    private async Task OnCountryChange(ChangeEventArgs e)
    {
        var cty = Countries.ByIso2(e.Value?.ToString());
        var set = cty is null || cty.Numeric == 0;
        model!["c"] = set ? "" : cty!.Iso2;
        model["co"] = set ? "" : cty!.Name;
        model["countryCode"] = set ? "" : cty!.Numeric.ToString();
        Show(await Mgmt.SetAttributesAsync(await Actor(), Dn!, new Dictionary<string, string?>
        { ["c"] = model["c"], ["co"] = model["co"], ["countryCode"] = model["countryCode"] }, "country"));
    }

    private async Task ApplyHomeFolder()
    {
        var drive = homeConnect ? homeDriveSel : "";
        model!["homeDirectory"] = homePath;
        model["homeDrive"] = drive;
        Show(await Mgmt.SetAttributesAsync(await Actor(), Dn!, new Dictionary<string, string?>
        { ["homeDirectory"] = homePath, ["homeDrive"] = drive }, "home folder"));
    }

    private async Task AddOther(string key)
    {
        var v = otherInput.GetValueOrDefault(key);
        if (string.IsNullOrWhiteSpace(v)) return;
        var list = otherVals.TryGetValue(key, out var l) ? l : (otherVals[key] = new());
        list.Add(v.Trim());
        otherInput[key] = "";
        Show(await Mgmt.SetMultiValueAsync(await Actor(), Dn!, OtherAttr(key), list));
    }

    private async Task RemoveOther(string key, string val)
    {
        if (!otherVals.TryGetValue(key, out var list)) return;
        list.Remove(val);
        Show(await Mgmt.SetMultiValueAsync(await Actor(), Dn!, OtherAttr(key), list));
    }

    private static string Rdn(string? dn)
    {
        if (string.IsNullOrEmpty(dn)) return "";
        var eq = dn.IndexOf('='); if (eq < 0) return dn;
        var comma = dn.IndexOf(',', eq);
        var val = comma < 0 ? dn[(eq + 1)..] : dn[(eq + 1)..comma];
        return val.Replace("\\,", ",").Replace("\\", "");
    }

    private static string ParentOf(string? dn)
    {
        if (string.IsNullOrEmpty(dn)) return "";
        var comma = dn.IndexOf(','); return comma < 0 ? "" : dn[(comma + 1)..];
    }
    private async Task ResetPassword()
    {
        Show(await Mgmt.ResetPasswordAsync(await Actor(), Dn!, resetPwd, false));
        resetPwd = "";
    }
    private async Task SetExpiry() => Show(await Mgmt.SetAccountOptionsAsync(await Actor(), Dn!, new AccountOptions(AccountExpiresUtc: expiry)));
    private async Task ClearExpiry() { expiry = null; Show(await Mgmt.SetAccountOptionsAsync(await Actor(), Dn!, new AccountOptions(ClearAccountExpiry: true))); }

    private void Show(OperationResult r) { ok = r.Success; banner = r.Success ? "Saved." : ("Error: " + r.Message); }
}
